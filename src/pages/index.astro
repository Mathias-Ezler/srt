---
import OperatorLayout from '../layouts/OperatorLayout.astro';
import { getCurrentMember } from '../lib/auth';
import { createApiClient } from '../lib/supabase-api';

const { member } = await getCurrentMember(Astro);

if (!member) {
  return Astro.redirect('/login');
}

const DEFAULT_PHOTO = '/images/default-operator.jpg';
const supabase = createApiClient(Astro.request, Astro.cookies);

// --- Foto: el bucket es privado, así que la URL firmada se genera aquí ---
async function resolvePhoto(path: string | null): Promise<string> {
  if (!path) return DEFAULT_PHOTO;
  if (/^https?:\/\//.test(path)) return path;

  const { data } = await supabase.storage.from('avatars').createSignedUrl(path, 3600);
  return data?.signedUrl ?? DEFAULT_PHOTO;
}

// --- ¿Es Líder? (tiene el permiso admin.access) ---
async function checkLeader(): Promise<boolean> {
  const { data: row } = await supabase
    .from('members')
    .select('rank_id')
    .eq('id', member.id)
    .maybeSingle();

  if (!row?.rank_id) return false;

  const { data: perm } = await supabase
    .from('rank_permissions')
    .select('permission_key')
    .eq('rank_id', row.rank_id)
    .eq('permission_key', 'admin.access')
    .maybeSingle();

  return !!perm;
}

const [photoSrc, isLeader] = await Promise.all([
  resolvePhoto(member.photo_url ?? null),
  checkLeader(),
]);

const memberName = member.full_name ?? 'Sin nombre';
const memberCallsign = member.callsign ?? '';
const memberRank = member.rank?.name ?? 'Sin rango';
const memberRankLevel = member.rank?.level ?? null;
const memberInsignia = member.rank?.insignia_url ?? null;

const fileNo = `SRT-${String(member.id ?? '')
  .replace(/-/g, '')
  .slice(0, 8)
  .toUpperCase() || '00000000'}`;

// --- Registro de actividad (por ahora solo el alta en el sistema) ---
const stamp = (d: Date) =>
  `${d
    .toLocaleDateString('es-PY', { day: '2-digit', month: 'short', year: 'numeric' })
    .replace(/\./g, '')
    .replace(/\s+/g, '-')
    .toUpperCase()} ${d.toLocaleTimeString('es-PY', { hour: '2-digit', minute: '2-digit', hour12: false })}`;

const log = member.created_at
  ? [{ stamp: stamp(new Date(member.created_at)), tag: 'SISTEMA', text: 'Alta en el sistema SRT' }]
  : [];

const kpis = [
  { label: 'Operaciones', hint: 'Participaciones' },
  { label: 'Como líder', hint: 'Al mando' },
  { label: 'Este mes', hint: 'Actividad' },
  { label: 'Condecoraciones', hint: 'Otorgadas' },
];

const shortcuts = [
  { code: 'A', label: 'Editar mi ficha', href: '/perfil' },
  { code: 'B', label: 'Ver miembros', href: '/miembros' },
  { code: 'C', label: 'Mapa táctico', href: '/mapa' },
  { code: 'D', label: 'Estadísticas', href: '/estadisticas' },
  { code: 'E', label: 'Nueva operación', href: null },
];
---

<OperatorLayout title="Inicio" active="inicio" isLeader={isLeader}>
  <div class="mx-auto grid min-h-full max-w-6xl gap-4 lg:grid-cols-[300px_1fr] lg:gap-6">
    <!-- MI FICHA -->
    <aside class="brackets flex min-h-0 flex-col border border-base-600/60 bg-base-900">
      <div class="relative min-h-[240px] flex-1 overflow-hidden bg-base-800">
        <img
          src={photoSrc}
          alt={`Fotografía de ${memberName}`}
          class="absolute inset-0 h-full w-full object-cover grayscale-[.3] contrast-110"
          onerror="this.onerror=null;this.src='/images/default-operator.jpg'"
        />
        <div class="scan absolute inset-0"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-base-950 via-base-950/10 to-transparent"></div>

        <div class="absolute left-3 top-3 border border-gold-500/50 bg-base-950/90 px-2.5 py-1">
          <span class="font-mono text-[10px] uppercase tracking-wider text-gold-500">
            [{memberCallsign || 'SIN PLACA'}]
          </span>
        </div>

        <div class="absolute inset-x-0 bottom-0 p-4">
          <p class="font-mono text-[10px] tracking-[0.2em] text-silver-300">Operador SRT</p>
          <h2 class="mt-1 font-display text-2xl font-bold uppercase leading-tight tracking-wide">
            {memberName}
          </h2>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-base-600/50 p-4">
        <div>
          <p class="font-mono text-[10px] tracking-[0.2em] text-silver-300">Rango</p>
          <p class="mt-1 font-display text-xl font-semibold uppercase leading-none text-gold-500">
            {memberRank}
          </p>
        </div>

        {memberRankLevel !== null && (
          <div class="flex h-11 w-11 shrink-0 items-center justify-center border border-base-600 bg-base-800">
            {memberInsignia ? (
              <img src={memberInsignia} alt={`Insignia de ${memberRank}`} class="h-8 w-8 object-contain" />
            ) : (
              <span class="font-mono text-sm text-silver-300">{memberRankLevel}</span>
            )}
          </div>
        )}
      </div>

      <div class="flex items-center justify-between border-t border-base-600/50 px-4 py-2.5">
        <span class="font-mono text-[10px] tracking-[0.2em] text-silver-300">{fileNo}</span>
        <a
          href="/perfil"
          class="font-mono text-[10px] uppercase tracking-[0.2em] text-gold-500 hover:text-bone-100"
        >
          Editar ficha →
        </a>
      </div>

      <div class="barcode mx-4 mb-4 h-5"></div>
    </aside>

    <!-- COLUMNA DERECHA -->
    <div class="flex min-h-0 flex-col gap-4 lg:gap-6">
      <!-- MIS CIFRAS -->
      <section>
        <div class="mb-3 flex items-center gap-4">
          <span class="font-mono text-[10px] tracking-[0.25em] text-silver-300">Mis cifras</span>
          <div class="h-px flex-1 bg-base-600/50"></div>
        </div>

        <div class="grid grid-cols-2 gap-px border border-base-600/50 bg-base-600/50 lg:grid-cols-4">
          {kpis.map((kpi) => (
            <div class="bg-base-900 px-4 py-3">
              <p class="font-mono text-[10px] tracking-[0.15em] text-silver-300">{kpi.label}</p>
              <p class="mt-1 font-display text-3xl leading-none text-base-600">—</p>
              <p class="mt-1 font-mono text-[9px] tracking-wider text-base-600">
                {kpi.hint} · Próximamente
              </p>
            </div>
          ))}
        </div>
      </section>

      <div class="grid min-h-0 flex-1 gap-4 lg:grid-cols-[1fr_250px] lg:gap-6">
        <!-- MI ACTIVIDAD -->
        <section class="brackets flex min-h-[220px] flex-col border border-base-600/60 bg-base-900">
          <div class="flex shrink-0 items-end justify-between gap-4 border-b border-base-600/50 px-5 py-4">
            <div>
              <p class="font-mono text-[10px] tracking-[0.25em] text-gold-500">Activity log</p>
              <h2 class="mt-1 font-display text-xl font-bold uppercase tracking-wide">
                Mi actividad
              </h2>
            </div>
            <span class="font-mono text-[10px] tracking-[0.2em] text-silver-300">Últimas 5</span>
          </div>

          <ol class="thin-scroll min-h-0 flex-1 overflow-y-auto p-5 font-mono text-xs">
            {log.map((entry) => (
              <li class="flex gap-3 border-l-2 border-base-600 pl-3 pb-3">
                <span class="shrink-0 tabular-nums text-silver-300">[{entry.stamp}]</span>
                <span class="shrink-0 text-gold-500">{entry.tag}</span>
                <span class="text-bone-100">{entry.text}</span>
              </li>
            ))}

            <li class="border-l-2 border-dashed border-base-600 pl-3 text-base-600">
              Las operaciones en las que participes aparecerán aquí.
            </li>
          </ol>
        </section>

        <!-- ACCESOS RÁPIDOS -->
        <section class="border border-base-600/60 bg-base-900">
          <div class="border-b border-base-600/50 px-4 py-3">
            <p class="font-mono text-[10px] tracking-[0.25em] text-silver-300">Accesos rápidos</p>
          </div>

          <ul class="p-2">
            {shortcuts.map((item) => (
              <li>
                {item.href ? (
                  <a
                    href={item.href}
                    class="group flex items-center gap-3 border-l-2 border-transparent px-3 py-2.5 hover:border-gold-500 hover:bg-base-800"
                  >
                    <span class="font-mono text-[10px] text-gold-500">{item.code}</span>
                    <span class="font-display text-sm uppercase tracking-wider text-silver-300 group-hover:text-bone-100">
                      {item.label}
                    </span>
                    <span class="ml-auto text-gold-500" aria-hidden="true">→</span>
                  </a>
                ) : (
                  <div class="flex items-center gap-3 border-l-2 border-transparent px-3 py-2.5 opacity-50">
                    <span class="font-mono text-[10px] text-base-600">{item.code}</span>
                    <span class="font-display text-sm uppercase tracking-wider text-silver-300">
                      {item.label}
                    </span>
                    <span class="ml-auto font-mono text-[9px] uppercase tracking-wider text-base-600">
                      Pronto
                    </span>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>
  </div>
</OperatorLayout>