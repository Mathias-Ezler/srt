---
import OperatorLayout from '../layouts/OperatorLayout.astro';
import { getCurrentMember } from '../lib/auth';
import { createApiClient } from '../lib/supabase-api';

const { member } = await getCurrentMember(Astro);

if (!member) {
  return Astro.redirect('/login');
}

const supabase = createApiClient(Astro.request, Astro.cookies);
const DEFAULT_PHOTO = '/img/default-operator.jpg';

// =========================================================
// FOTO (bucket privado: URL firmada generada en el servidor)
// =========================================================

async function resolvePhoto(path: string | null): Promise<string> {
  if (!path) return DEFAULT_PHOTO;
  if (/^https?:\/\//.test(path)) return path;

  const { data } = await supabase.storage.from('avatars').createSignedUrl(path, 3600);
  return data?.signedUrl ?? DEFAULT_PHOTO;
}

// =========================================================
// ¿ES LÍDER?
// =========================================================

const rankId = member.rank?.id ?? null;

async function checkLeader(): Promise<boolean> {
  if (!rankId) return false;

  const { data: perm } = await supabase
    .from('rank_permissions')
    .select('permission_key')
    .eq('rank_id', rankId)
    .eq('permission_key', 'admin.access')
    .maybeSingle();

  return !!perm;
}

const [photoSrc, isLeader] = await Promise.all([
  resolvePhoto(member.photo_url ?? null),
  checkLeader(),
]);

const memberName = member.full_name ?? 'Sin nombre';
const memberCallsign = member.callsign ?? '';
const memberRank = member.rank?.name ?? 'Sin rango';
const memberRankLevel = member.rank?.level ?? null;
const memberInsignia = member.rank?.insignia_url ?? null;

const fileNo = `SRT-${String(member.id ?? '')
  .replace(/-/g, '')
  .slice(0, 8)
  .toUpperCase() || '00000000'}`;

const joined = member.created_at
  ? new Intl.DateTimeFormat('es-PY', { day: '2-digit', month: 'short', year: 'numeric' }).format(
      new Date(member.created_at)
    )
  : '—';

const formatDateTime = (date: string): string =>
  new Intl.DateTimeFormat('es-PY', {
    day: '2-digit',
    month: '2-digit',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).format(new Date(date));

// =========================================================
// DESPLIEGUES DEL OPERADOR
// =========================================================

const { data: deploymentMemberships, error: deploymentMembershipsError } = await supabase
  .from('deployment_members')
  .select(
    `
    id,
    role,
    member_id,
    deployment_id,
    created_at,
    deployments (
      id,
      code,
      title,
      type,
      location,
      created_at,
      created_by,
      report_status
    )
  `
  )
  .eq('member_id', member.id)
  .order('created_at', { ascending: false });

if (deploymentMembershipsError) {
  console.error('HOME DEPLOYMENTS ERROR:', deploymentMembershipsError);
}

// Estado del informe: se traduce a etiqueta + color.
// Los valores reconocidos son una suposición; los demás se muestran tal cual.
type StatusMeta = { key: string; label: string; dot: string; text: string };

const statusMeta = (raw: string | null): StatusMeta => {
  const v = (raw ?? '').toLowerCase().trim();

  if (['pending', 'pendiente', 'draft', 'borrador', 'missing'].includes(v)) {
    return { key: 'pending', label: 'Pendiente', dot: 'bg-gold-500', text: 'text-gold-500' };
  }
  if (['submitted', 'enviado', 'review', 'en_revision', 'revision'].includes(v)) {
    return { key: 'review', label: 'En revisión', dot: 'bg-blue-600', text: 'text-blue-600' };
  }
  if (['approved', 'aprobado', 'completed', 'completado', 'closed', 'cerrado', 'done'].includes(v)) {
    return { key: 'approved', label: 'Aprobado', dot: 'bg-green-500', text: 'text-green-500' };
  }
  if (['rejected', 'rechazado', 'returned', 'devuelto'].includes(v)) {
    return { key: 'returned', label: 'Devuelto', dot: 'bg-danger-500', text: 'text-danger-500' };
  }
  return {
    key: 'other',
    label: v ? v.toUpperCase() : 'SIN ESTADO',
    dot: 'bg-base-600',
    text: 'text-silver-300',
  };
};

type Activity = {
  id: number;
  code: string;
  title: string;
  type: string;
  location: string;
  createdAt: string;
  role: string;
  meta: StatusMeta;
};

const activities: Activity[] = (deploymentMemberships ?? [])
  .map((item: any) => {
    const deployment = Array.isArray(item.deployments) ? item.deployments[0] : item.deployments;
    if (!deployment) return null;

    return {
      id: deployment.id,
      code: deployment.code,
      title: deployment.title,
      type: deployment.type,
      location: deployment.location,
      createdAt: deployment.created_at,
      role: String(item.role ?? 'operador'),
      meta: statusMeta(deployment.report_status),
    };
  })
  .filter((item): item is Activity => item !== null);

// =========================================================
// CIFRAS
// =========================================================

const now = new Date();

// Últimos 6 meses (para el gráfico de barras)
const months = Array.from({ length: 6 }, (_, i) => {
  const d = new Date(now.getFullYear(), now.getMonth() - (5 - i), 1);
  return {
    key: `${d.getFullYear()}-${d.getMonth()}`,
    label: d.toLocaleDateString('es-PY', { month: 'short' }).replace('.', ''),
    count: 0,
  };
});

activities.forEach((a) => {
  const d = new Date(a.createdAt);
  const slot = months.find((m) => m.key === `${d.getFullYear()}-${d.getMonth()}`);
  if (slot) slot.count += 1;
});

const maxMonth = Math.max(1, ...months.map((m) => m.count));
const totalDeployments = activities.length;
const leaderDeployments = activities.filter((a) => a.role === 'alpha').length;
const leaderShare = totalDeployments ? Math.round((leaderDeployments / totalDeployments) * 100) : 0;
const thisMonth = months[5].count;
const delta = thisMonth - months[4].count;

const deltaText =
  delta > 0
    ? `+${delta} vs mes anterior`
    : delta < 0
      ? `${delta} vs mes anterior`
      : 'Igual que el mes anterior';

// =========================================================
// ACTIVIDAD, ESTADO DE INFORMES Y TAREAS
// =========================================================

const recentActivities = activities.slice(0, 8);
const pendingActivities = activities.filter((a) => a.meta.key === 'pending');

const tabs = [
  {
    id: 'recent',
    label: 'Recientes',
    items: recentActivities,
    empty: ['Sin actividad registrada', 'Los despliegues en los que participes aparecerán aquí.'],
  },
  {
    id: 'pending',
    label: 'Informes pendientes',
    items: pendingActivities,
    empty: ['Todo al día', 'No tienes informes pendientes.'],
  },
];

const statusSummary = ['pending', 'review', 'approved', 'returned', 'other']
  .map((key) => {
    const group = activities.filter((a) => a.meta.key === key);
    return group.length ? { ...group[0].meta, count: group.length } : null;
  })
  .filter((s): s is StatusMeta & { count: number } => s !== null);

const tasks = pendingActivities.slice(0, 3);

const tools = [
  { label: 'Miembros', href: '/miembros', icon: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3 3-5 6-5s6 2 6 5M17 11a3 3 0 1 0 0-6M15 15c3 0 6 2 6 5' },
  { label: 'Mapa', href: '/mapa', icon: 'M9 4 3 6v14l6-2 6 2 6-2V4l-6 2zM9 4v14M15 6v14' },
  { label: 'Stats', href: '/estadisticas', icon: 'M4 20V10M10 20V4M16 20v-8M22 20H2' },
];
---

<OperatorLayout title="Inicio" active="inicio" isLeader={isLeader}>
  <div
    class="mx-auto grid min-h-full max-w-[1400px] gap-4 lg:grid-cols-[280px_minmax(0,1fr)_270px] lg:gap-5"
  >
    <!-- =====================================================
         COLUMNA 1 · MI FICHA
         ===================================================== -->
    <aside class="brackets flex min-h-0 flex-col border border-base-600/60 bg-base-900">
      <div class="relative min-h-[240px] flex-1 overflow-hidden bg-base-800">
        <img
          src={photoSrc}
          alt={`Fotografía de ${memberName}`}
          class="absolute inset-0 h-full w-full object-cover grayscale-[.3] contrast-110"
          onerror="this.onerror=null;this.src='/images/default-operator.jpg'"
        />
        <div class="scan absolute inset-0"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-base-950 via-base-950/10 to-transparent"></div>

        <div class="absolute left-3 top-3 border border-gold-500/50 bg-base-950/90 px-2.5 py-1">
          <span class="font-mono text-[10px] uppercase tracking-wider text-gold-500">
            [{memberCallsign || 'SIN PLACA'}]
          </span>
        </div>

        <div class="absolute inset-x-0 bottom-0 p-4">
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-silver-300">Operador SRT</p>
          <h2 class="mt-1 font-display text-2xl font-bold uppercase leading-tight tracking-wide">
            {memberName}
          </h2>
        </div>
      </div>

      <div class="flex items-center justify-between gap-3 border-t border-base-600/50 p-4">
        <div>
          <p class="font-mono text-[10px] uppercase tracking-[0.2em] text-silver-300">Rango</p>
          <p class="mt-1 font-display text-xl font-semibold uppercase leading-none text-gold-500">
            {memberRank}
          </p>
        </div>

        {memberRankLevel !== null && (
          <div class="flex h-11 w-11 shrink-0 items-center justify-center border border-base-600 bg-base-800">
            {memberInsignia ? (
              <img src={memberInsignia} alt={`Insignia de ${memberRank}`} class="h-8 w-8 object-contain" />
            ) : (
              <span class="font-mono text-sm text-silver-300">{memberRankLevel}</span>
            )}
          </div>
        )}
      </div>

      <dl class="shrink-0 space-y-1.5 border-t border-base-600/50 px-4 py-3 font-mono text-[10px] uppercase tracking-[0.15em]">
        <div class="flex justify-between gap-3">
          <dt class="text-silver-300">Expediente</dt>
          <dd class="text-bone-100">{fileNo}</dd>
        </div>
        <div class="flex justify-between gap-3">
          <dt class="text-silver-300">Alta</dt>
          <dd class="text-bone-100">{joined}</dd>
        </div>
      </dl>

      <a
        href="/perfil"
        class="mx-4 mb-3 flex items-center justify-between border border-base-600/70 bg-base-800 px-4 py-2.5 font-mono text-[10px] uppercase tracking-[0.2em] text-silver-300 hover:border-gold-500/60 hover:text-gold-500"
      >
        <span>Ver ficha completa</span>
        <span aria-hidden="true">→</span>
      </a>

      <div class="barcode mx-4 mb-4 h-4"></div>
    </aside>

    <!-- =====================================================
         COLUMNA 2 · CIFRAS + ACTIVIDAD
         ===================================================== -->
    <div class="flex min-h-0 min-w-0 flex-col gap-4 lg:gap-5">
      <!-- CIFRAS -->
      <section>
        <div class="mb-2 flex items-center gap-4">
          <span class="font-mono text-[10px] uppercase tracking-[0.25em] text-silver-300">Mis cifras</span>
          <div class="h-px flex-1 bg-base-600/50"></div>
        </div>

        <div class="grid grid-cols-2 gap-3 xl:grid-cols-4">
          <!-- Despliegues + barras 6 meses -->
          <div class="border border-base-600/60 bg-base-900 p-3.5">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-silver-300">Despliegues</p>
            <p class="mt-1 font-display text-3xl leading-none text-bone-100">{totalDeployments}</p>

            <div class="mt-3 flex h-9 items-end gap-1" role="img" aria-label="Despliegues por mes, últimos 6 meses">
              {months.map((m, i) => (
                <div
                  class:list={['flex-1', i === 5 ? 'bg-gold-500' : 'bg-base-600']}
                  style={`height:${Math.max(10, (m.count / maxMonth) * 100)}%`}
                  title={`${m.label}: ${m.count}`}
                ></div>
              ))}
            </div>
            <div class="mt-1 flex gap-1 font-mono text-[8px] uppercase text-base-600">
              {months.map((m) => <span class="flex-1 text-center">{m.label.slice(0, 3)}</span>)}
            </div>
          </div>

          <!-- Como líder -->
          <div class="border border-base-600/60 bg-base-900 p-3.5">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-silver-300">Como líder</p>
            <p class="mt-1 font-display text-3xl leading-none text-bone-100">{leaderDeployments}</p>

            <div class="mt-4 h-1.5 bg-base-800">
              <div class="h-full bg-gold-500" style={`width:${leaderShare}%`}></div>
            </div>
            <p class="mt-2 font-mono text-[9px] uppercase tracking-wider text-silver-300">
              {leaderShare}% de tus despliegues
            </p>
          </div>

          <!-- Este mes -->
          <div class="border border-base-600/60 bg-base-900 p-3.5">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-silver-300">Este mes</p>
            <p class="mt-1 font-display text-3xl leading-none text-bone-100">{thisMonth}</p>

            <p
              class:list={[
                'mt-4 font-mono text-[9px] uppercase tracking-wider',
                delta > 0 ? 'text-gold-500' : delta < 0 ? 'text-danger-500' : 'text-silver-300',
              ]}
            >
              {deltaText}
            </p>
          </div>

          <!-- Condecoraciones -->
          <div class="border border-base-600/60 bg-base-900 p-3.5">
            <p class="font-mono text-[10px] uppercase tracking-[0.15em] text-silver-300">Condecoraciones</p>
            <p class="mt-1 font-display text-3xl leading-none text-base-600">—</p>

            <div class="mt-4 flex gap-1.5" aria-hidden="true">
              {Array.from({ length: 5 }).map(() => <span class="h-4 w-4 border border-dashed border-base-600"></span>)}
            </div>
            <p class="mt-2 font-mono text-[9px] uppercase tracking-wider text-base-600">Próximamente</p>
          </div>
        </div>
      </section>

      <!-- ACTIVIDAD -->
      <section
        data-tabs
        class="brackets flex min-h-[300px] flex-1 flex-col border border-base-600/60 bg-base-900"
      >
        <div class="flex shrink-0 items-end justify-between gap-4 px-5 pt-4">
          <div>
            <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-gold-500">Activity log</p>
            <h2 class="mt-1 font-display text-xl font-bold uppercase tracking-wide">Mi actividad</h2>
          </div>

          <a
            href="/despliegues"
            class="font-mono text-[10px] uppercase tracking-[0.2em] text-silver-300 hover:text-gold-500"
          >
            Ver todos →
          </a>
        </div>

        <div role="tablist" class="mt-3 flex shrink-0 border-b border-base-600/50 px-3">
          {tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`tab-${tab.id}`}
              aria-controls={`panel-${tab.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              class="-mb-px flex items-center gap-2 border-b-2 border-transparent px-3 py-2.5 font-mono text-[10px] uppercase tracking-[0.2em] text-silver-300 hover:text-bone-100 aria-selected:border-gold-500 aria-selected:text-gold-500"
            >
              {tab.label}
              <span class="border border-base-600 px-1.5 py-px text-[9px] text-silver-300">
                {tab.items.length}
              </span>
            </button>
          ))}
        </div>

        {tabs.map((tab, i) => (
          <div
            role="tabpanel"
            id={`panel-${tab.id}`}
            aria-labelledby={`tab-${tab.id}`}
            hidden={i !== 0}
            class="thin-scroll min-h-0 flex-1 overflow-y-auto"
          >
            {tab.items.length > 0 ? (
              <ul>
                {tab.items.map((a) => (
                  <li class="border-b border-base-600/40 last:border-b-0">
                    <a href={`/despliegues/${a.id}`} class="group flex items-center gap-3 px-5 py-3 hover:bg-base-800">
                      <span class={`h-2 w-2 shrink-0 ${a.meta.dot}`}></span>

                      <div class="min-w-0 flex-1">
                        <p class="truncate font-display text-sm font-bold uppercase tracking-wide text-bone-100 group-hover:text-gold-500">
                          {a.title}
                        </p>
                        <p class="mt-0.5 truncate font-mono text-[10px] uppercase tracking-wider text-silver-300">
                          {a.code} <span class="text-base-600">//</span> {a.type} <span class="text-base-600">//</span> {a.location}
                        </p>
                      </div>

                      <div class="hidden shrink-0 text-right sm:block">
                        <p class="font-mono text-[10px] tabular-nums text-silver-300">{formatDateTime(a.createdAt)}</p>
                        <p class="mt-0.5 font-mono text-[9px] uppercase tracking-[0.15em]">
                          <span class={a.role === 'alpha' ? 'text-gold-500' : 'text-silver-300'}>{a.role}</span>
                          <span class="text-base-600"> · </span>
                          <span class={a.meta.text}>{a.meta.label}</span>
                        </p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <div class="flex h-full min-h-[160px] items-center justify-center p-6 text-center">
                <div>
                  <p class="font-display text-sm font-bold uppercase text-silver-300">{tab.empty[0]}</p>
                  <p class="mt-1 font-mono text-[10px] text-base-600">{tab.empty[1]}</p>
                </div>
              </div>
            )}
          </div>
        ))}
      </section>
    </div>

    <!-- =====================================================
         COLUMNA 3 · MI SITUACIÓN
         ===================================================== -->
    <aside class="thin-scroll flex min-h-0 flex-col gap-4 lg:gap-5 lg:overflow-y-auto">
      <!-- ESTADO DE INFORMES -->
      <section class="border border-base-600/60 bg-base-900">
        <div class="border-b border-base-600/50 px-4 py-2.5">
          <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-silver-300">Estado de informes</p>
        </div>

        <div class="p-4">
          <div class="flex h-2 gap-px bg-base-800" role="img" aria-label="Distribución de informes por estado">
            {statusSummary.map((s) => (
              <div class={s.dot} style={`width:${(s.count / totalDeployments) * 100}%`}></div>
            ))}
          </div>

          {statusSummary.length > 0 ? (
            <ul class="mt-3 space-y-1.5">
              {statusSummary.map((s) => (
                <li class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-wider">
                  <span class={`h-1.5 w-1.5 ${s.dot}`}></span>
                  <span class="text-silver-300">{s.label}</span>
                  <span class="ml-auto tabular-nums text-bone-100">{s.count}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 font-mono text-[10px] text-base-600">Sin despliegues registrados.</p>
          )}
        </div>
      </section>

      <!-- TAREAS -->
      <section class="border border-base-600/60 bg-base-900">
        <div class="flex items-center justify-between border-b border-base-600/50 px-4 py-2.5">
          <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-silver-300">Tareas asignadas</p>
          <span class="font-mono text-[10px] tabular-nums text-gold-500">{pendingActivities.length}</span>
        </div>

        <ul class="p-2">
          {tasks.length > 0 ? (
            tasks.map((a) => (
              <li>
                <a href={`/despliegues/${a.id}`} class="group flex items-center gap-3 border-l-2 border-transparent px-2.5 py-2 hover:border-gold-500 hover:bg-base-800">
                  <span class="h-3.5 w-3.5 shrink-0 border border-base-600 group-hover:border-gold-500"></span>
                  <span class="min-w-0">
                    <span class="block truncate font-display text-xs font-semibold uppercase tracking-wide text-bone-100">
                      Completar informe
                    </span>
                    <span class="block truncate font-mono text-[9px] uppercase tracking-wider text-silver-300">{a.code}</span>
                  </span>
                </a>
              </li>
            ))
          ) : (
            <li class="flex items-center gap-3 px-2.5 py-2 font-mono text-[10px] uppercase tracking-wider text-silver-300">
              <span class="flex h-3.5 w-3.5 shrink-0 items-center justify-center bg-gold-500 text-[9px] font-bold text-base-950">✓</span>
              Sin tareas pendientes
            </li>
          )}
        </ul>
      </section>

      <!-- COMUNICACIONES -->
      <section class="flex min-h-[110px] flex-1 flex-col border border-base-600/60 bg-base-900">
        <div class="border-b border-base-600/50 px-4 py-2.5">
          <p class="font-mono text-[10px] uppercase tracking-[0.25em] text-silver-300">Comunicaciones</p>
        </div>
        <div class="flex flex-1 items-center justify-center p-4 text-center">
          <div>
            <p class="font-display text-xs font-bold uppercase text-silver-300">Sin comunicados</p>
            <p class="mt-1 font-mono text-[10px] text-base-600">Los avisos del mando aparecerán aquí.</p>
          </div>
        </div>
      </section>

      <!-- ACCESOS -->
      <section class="border border-base-600/60 bg-base-900 p-3">
        <a
          href="/despliegues/nuevo"
          class="flex items-center gap-3 bg-gold-500 px-3 py-3 text-base-950 hover:bg-bone-100"
        >
          <span class="flex h-6 w-6 items-center justify-center border border-base-950/30 font-mono text-sm font-bold">+</span>
          <span class="font-display text-sm font-bold uppercase tracking-wider">Nuevo despliegue</span>
          <span class="ml-auto font-mono" aria-hidden="true">→</span>
        </a>

        <div class="mt-2 grid grid-cols-3 gap-2">
          {tools.map((tool) => (
            <a
              href={tool.href}
              class="group flex flex-col items-center gap-1.5 border border-base-600/60 py-2.5 text-silver-300 hover:border-gold-500/60 hover:text-gold-500"
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={tool.icon} />
              </svg>
              <span class="font-mono text-[9px] uppercase tracking-[0.15em]">{tool.label}</span>
            </a>
          ))}
        </div>
      </section>
    </aside>
  </div>
</OperatorLayout>

<script>
  // Pestañas del registro de actividad
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[role="tab"]');
    const panels = root.querySelectorAll<HTMLElement>('[role="tabpanel"]');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        panels.forEach((p) => {
          p.hidden = p.id !== tab.getAttribute('aria-controls');
        });
      });
    });
  });
</script>