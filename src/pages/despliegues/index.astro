---
import OperatorLayout from '../../layouts/OperatorLayout.astro';
import { getCurrentMember } from '../../lib/auth';
import { createApiClient } from '../../lib/supabase-api';

const { member } = await getCurrentMember(Astro);

if (!member) {
  return Astro.redirect('/login');
}

const supabase = createApiClient(Astro.request, Astro.cookies);

/* ============================================================
   PERMISOS
   ============================================================ */

   const rankId = member.rank?.id ?? null;

async function checkLeader(): Promise<boolean> {
  if (!rankId) return false;

  const { data: perm } = await supabase
    .from('rank_permissions')
    .select('permission_key')
    .eq('rank_id', rankId)
    .eq('permission_key', 'admin.access')
    .maybeSingle();

  return !!perm;
}

const isLeader = await checkLeader();

/* ============================================================
   DESPLIEGUES
   ============================================================ */

const { data, error } = await supabase
  .from('deployments')
  .select(
    `
    id,
    code,
    title,
    type,
    location,
    risk_level,
    status,
    report_status,
    created_by,
    created_at,
    deployment_members (
      member_id,
      role,
      members (
        id,
        full_name,
        callsign,
        rank_id
      )
    )
  `
  )
  .order('created_at', { ascending: false });

if (error) {
  console.error('Error obteniendo despliegues:', error);
}

const deployments: any[] = data ?? [];

/* ============================================================
   HELPERS
   ============================================================ */

const formatDate = (value: string | null) => {
  if (!value) return '—';

  return new Intl.DateTimeFormat('es-PY', {
    day: '2-digit',
    month: 'short',
    year: 'numeric',
  })
    .format(new Date(value))
    .replace(/\./g, '')
    .toUpperCase();
};

const statusLabel = (status: string | null) => {
  if (status === 'reviewed') {
    return 'Revisado';
  }

  return 'En espera';
};

const statusClass = (status: string | null) => {
  if (status === 'reviewed') {
    return 'border-emerald-500/40 bg-emerald-500/10 text-emerald-400';
  }

  return 'border-orange-500/40 bg-orange-500/10 text-orange-400';
};

/* Barra lateral según estado de revisión */

const accentClass = (status: string | null) => {
  if (status === 'reviewed') {
    return 'bg-emerald-500';
  }

  return 'bg-orange-500';
};

const riskLabel = (risk: string | null) =>
  risk
    ? (
        {
          low: 'Bajo',
          medium: 'Medio',
          high: 'Alto',
          critical: 'Crítico',
        } as Record<string, string>
      )[risk] ?? risk
    : null;

const riskLevel = (risk: string | null) =>
  (
    {
      low: 1,
      medium: 2,
      high: 3,
      critical: 4,
    } as Record<string, number>
  )[risk ?? ''] ?? 0;

const riskClass = (risk: string | null) =>
  (
    {
      low: 'text-blue-600',
      medium: 'text-silver-300',
      high: 'text-gold-500',
      critical: 'text-danger-500',
    } as Record<string, string>
  )[risk ?? ''] ?? 'text-base-600';

/* ============================================================
   TIPOS DE DESPLIEGUE
   ============================================================ */

const normalizeType = (type: string | null) =>
  type?.trim().toLowerCase() ?? '';

const knownTypes = [
  'atrincheramiento vehicular',
  'emboscada',
  'atrincheramiento con rehenes',
  'secuestro',
];

const isOtherType = (type: string | null) => {
  const normalized = normalizeType(type);

  return !knownTypes.includes(normalized);
};

const filters = [
  {
    key: '',
    label: 'Todos',
  },
  {
    key: 'atrincheramiento vehicular',
    label: 'Atrincheramiento Vehicular',
  },
  {
    key: 'atrincheramiento con rehenes',
    label: 'Atrincheramiento con Rehenes',
  },
  {
    key: 'emboscadas',
    label: 'Emboscada',
  },
  {
    key: 'secuestro',
    label: 'Secuestros',
  },
  {
    key: '__other__',
    label: 'Otros',
  },
].map((filter) => ({
  ...filter,

  count:
    filter.key === ''
      ? deployments.length
      : filter.key === '__other__'
        ? deployments.filter((d) =>
            isOtherType(d.type)
          ).length
        : deployments.filter(
            (d) =>
              normalizeType(d.type) ===
              normalizeType(filter.key)
          ).length,
}));

/* Misma plantilla de columnas en cabecera y filas */

const cols =
  'lg:grid-cols-[96px_minmax(0,1fr)_190px_100px_104px]';
---

<OperatorLayout
  title="Despliegues"
  active="despliegues"
  isLeader={isLeader}
>
  <div class="mx-auto flex h-full min-h-0 max-w-6xl flex-col gap-4">

    <!-- ======================================================
         CABECERA
         ====================================================== -->

    <section
      class="flex shrink-0 flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p
          class="font-mono text-[10px] uppercase tracking-[0.25em] text-gold-500"
        >
          Registro operacional
        </p>

        <h2
          class="mt-1 font-display text-3xl font-bold uppercase leading-none tracking-wide"
        >
          Despliegues
        </h2>

        <p
          class="mt-2 font-mono text-[10px] uppercase tracking-wider text-silver-300"
        >
          Historial de intervenciones y operaciones SRT
        </p>
      </div>

      <a
        href="/despliegues/nuevo"
        class="flex shrink-0 items-center justify-center gap-3 bg-gold-500 px-5 py-3 text-base-950 hover:bg-bone-100"
      >
        <span
          class="font-mono text-base font-bold leading-none"
        >
          +
        </span>

        <span
          class="font-display text-sm font-bold uppercase tracking-wider"
        >
          Nuevo despliegue
        </span>
      </a>
    </section>

    <!-- ======================================================
         BÚSQUEDA + FILTROS
         ====================================================== -->

    <section
      class="flex shrink-0 flex-col gap-3 border border-base-600/60 bg-base-900 p-3 lg:flex-row lg:items-center"
    >

      <!-- BUSCADOR -->

      <div class="relative lg:w-80">
        <svg
          viewBox="0 0 24 24"
          class="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-base-600"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle
            cx="11"
            cy="11"
            r="7"
          ></circle>

          <path d="m20 20-3.5-3.5"></path>
        </svg>

        <input
          id="deployment-search"
          type="search"
          placeholder="Buscar código, título o lugar"
          aria-label="Buscar despliegues"
          class="w-full border border-base-600 bg-base-950 py-2.5 pl-9 pr-9 font-mono text-xs text-bone-100 outline-none placeholder:text-base-600 focus:border-gold-500/60"
        />

        <kbd
          class="pointer-events-none absolute right-2.5 top-1/2 hidden -translate-y-1/2 border border-base-600 px-1.5 py-px font-mono text-[9px] text-base-600 sm:block"
        >
          /
        </kbd>
      </div>

      <!-- FILTROS POR TIPO -->

      <div
        class="flex flex-wrap gap-2"
        role="group"
        aria-label="Filtrar por tipo de despliegue"
      >
        {filters.map((f, i) => (
          <button
            type="button"
            data-filter={f.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
            class="flex items-center gap-2 border border-base-600 px-3 py-2 font-mono text-[10px] uppercase tracking-[0.15em] text-silver-300 hover:border-gold-500/50 hover:text-bone-100 aria-pressed:border-gold-500 aria-pressed:bg-gold-500/10 aria-pressed:text-gold-500"
          >
            {f.label}

            <span class="tabular-nums opacity-70">
              {f.count}
            </span>
          </button>
        ))}
      </div>
    </section>

    <!-- ======================================================
         ERROR
         ====================================================== -->

    {error && (
      <div
        class="shrink-0 border border-danger-500/40 bg-danger-500/10 p-4"
      >
        <p
          class="font-mono text-[10px] uppercase tracking-wider text-danger-500"
        >
          Error al cargar los despliegues
        </p>

        <p
          class="mt-1 font-mono text-xs text-silver-300"
        >
          {error.message}
        </p>
      </div>
    )}

    <!-- ======================================================
         REGISTRO
         ====================================================== -->

    <section
      class="brackets flex min-h-[240px] flex-1 flex-col border border-base-600/60 bg-base-900"
    >

      <!-- CABECERA DE COLUMNAS -->

      <div
        class={`hidden shrink-0 gap-4 border-b border-base-600/50 bg-base-950/60 py-2.5 pl-5 pr-4 font-mono text-[9px] uppercase tracking-[0.2em] text-silver-300 lg:grid ${cols}`}
      >
        <span>Código</span>

        <span>Despliegue</span>

        <span>Alpha</span>

        <span>Riesgo</span>

        <span class="text-right">
          Estado
        </span>
      </div>

      <!-- FILAS -->

      <div
        id="deployment-list"
        class="thin-scroll min-h-0 flex-1 overflow-y-auto"
      >

        {deployments.map((d) => {
          const alpha =
            d.deployment_members?.find(
              (p: any) =>
                p.role === 'alpha'
            );

          const alphaMember =
            Array.isArray(alpha?.members)
              ? alpha.members[0]
              : alpha?.members;

          const alphaName =
            alphaMember?.full_name ??
            'Sin Alpha';

          const alphaCallsign =
            alphaMember?.callsign ??
            '---';

          const level =
            riskLevel(
              d.risk_level
            );

          return (
            <a
              href={`/despliegues/${d.id}`}
              class={`deployment-row group relative flex flex-col gap-1.5 border-b border-base-600/40 py-3 pl-5 pr-4 hover:bg-base-800 lg:grid lg:items-center lg:gap-4 ${cols}`}
              data-type={normalizeType(d.type)}
              data-search={`${d.code} ${d.title} ${d.location} ${d.type} ${alphaName} ${alphaCallsign}`.toLowerCase()}
            >

              <!-- Barra lateral -->

              <span
                class={`absolute inset-y-0 left-0 w-1 ${accentClass(d.report_status)}`}
              ></span>

              <!-- Código + fecha -->

              <div
                class="flex items-center justify-between gap-3 lg:block"
              >
                <p
                  class="font-mono text-[11px] tracking-[0.15em] text-gold-500"
                >
                  {d.code}
                </p>

                <p
                  class="font-mono text-[9px] uppercase tracking-wider text-silver-300 lg:mt-0.5"
                >
                  {formatDate(d.created_at)}
                </p>
              </div>

              <!-- Título + tipo/lugar -->

              <div class="min-w-0">
                <p
                  class="truncate font-display text-base font-bold uppercase tracking-wide text-bone-100 group-hover:text-gold-500"
                >
                  {d.title}
                </p>

                <p
                  class="mt-0.5 truncate font-mono text-[10px] uppercase tracking-wider text-silver-300"
                >
                  {d.type}

                  <span class="text-base-600">
                    //
                  </span>

                  {d.location}
                </p>
              </div>

              <!-- Alpha -->

              <p
                class="truncate font-mono text-[10px] uppercase tracking-wider text-silver-300"
              >
                <span class="text-base-600 lg:hidden">
                  Alpha
                </span>

                <span class="text-gold-500">
                  {alphaCallsign}
                </span>

                · {alphaName}
              </p>

              <!-- Riesgo -->

              <div
                class={`flex items-center gap-2 ${riskClass(d.risk_level)}`}
              >
                <span
                  class="flex items-end gap-0.5"
                  aria-hidden="true"
                >
                  {[1, 2, 3, 4].map((n) => (
                    <span
                      class={`w-1.5 ${
                        n <= level
                          ? 'bg-current'
                          : 'bg-base-600/60'
                      }`}
                      style={`height:${6 + n * 2}px`}
                    ></span>
                  ))}
                </span>

                <span
                  class="font-mono text-[10px] uppercase tracking-wider"
                >
                  {riskLabel(d.risk_level) ?? '—'}
                </span>
              </div>

              <!-- ESTADO DE REVISIÓN -->

              <div class="lg:text-right">
                <span
                  class={`inline-block border px-2 py-0.5 font-mono text-[9px] uppercase tracking-wider ${statusClass(d.report_status)}`}
                >
                  {statusLabel(d.report_status)}
                </span>
              </div>
            </a>
          );
        })}

        <!-- ==================================================
             SIN REGISTROS
             ================================================== -->

        {deployments.length === 0 && !error && (
          <div
            class="flex h-full min-h-[240px] items-center justify-center p-8 text-center"
          >
            <div>
              <p
                class="font-mono text-[10px] uppercase tracking-[0.25em] text-base-600"
              >
                Sin registros
              </p>

              <h3
                class="mt-2 font-display text-2xl font-bold uppercase tracking-wide text-silver-300"
              >
                No hay despliegues registrados
              </h3>

              <a
                href="/despliegues/nuevo"
                class="mt-5 inline-flex border border-gold-500/60 bg-gold-500/10 px-5 py-3 font-mono text-[10px] uppercase tracking-[0.2em] text-gold-500 hover:bg-gold-500 hover:text-base-950"
              >
                + Crear primer despliegue
              </a>
            </div>
          </div>
        )}

        <!-- ==================================================
             SIN RESULTADOS
             ================================================== -->

        <div
          id="no-results"
          hidden
          class="flex min-h-[200px] items-center justify-center p-8 text-center"
        >
          <div>
            <p
              class="font-display text-lg font-bold uppercase text-silver-300"
            >
              Sin resultados
            </p>

            <p
              class="mt-1 font-mono text-[10px] uppercase tracking-wider text-base-600"
            >
              Prueba con otra búsqueda o quita los filtros.
            </p>
          </div>
        </div>
      </div>

      <!-- ==================================================
           PIE
           ================================================== -->

      <div
        class="flex shrink-0 items-center justify-between border-t border-base-600/50 px-5 py-2"
      >
        <span
          class="font-mono text-[10px] uppercase tracking-[0.2em] text-silver-300"
        >
          Registro
        </span>

        <span
          id="deployment-count"
          class="font-mono text-[10px] uppercase tracking-[0.2em] tabular-nums text-silver-300"
        >
          {deployments.length}

          {deployments.length === 1
            ? 'registro'
            : 'registros'}
        </span>
      </div>
    </section>
  </div>
</OperatorLayout>

<style>
  .deployment-row[data-hidden='true'] {
    display: none;
  }
</style>

<script>
  const search =
    document.querySelector<HTMLInputElement>(
      '#deployment-search'
    );

  const filterButtons =
    Array.from(
      document.querySelectorAll<HTMLButtonElement>(
        '[data-filter]'
      )
    );

  const rows =
    Array.from(
      document.querySelectorAll<HTMLElement>(
        '.deployment-row'
      )
    );

  const count =
    document.querySelector<HTMLElement>(
      '#deployment-count'
    );

  const noResults =
    document.querySelector<HTMLElement>(
      '#no-results'
    );

  let selectedType = '';

  const knownTypes = [
    'atrincheramiento vehicular',
    'emboscada',
    'atrincheramiento con rehenes',
    'secuestro',
  ];

  function normalizeType(value: string) {
    return value
      .trim()
      .toLowerCase();
  }

  function applyFilters() {
    const query =
      search?.value
        .trim()
        .toLowerCase() ?? '';

    let visible = 0;

    rows.forEach((row) => {
      const rowType =
        normalizeType(
          row.dataset.type ?? ''
        );

      const matchesSearch =
        !query ||
        (
          row.dataset.search ?? ''
        ).includes(query);

      let matchesType = true;

      if (selectedType) {
        if (
          selectedType === '__other__'
        ) {
          matchesType =
            !knownTypes.includes(
              rowType
            );
        } else {
          matchesType =
            rowType ===
            normalizeType(
              selectedType
            );
        }
      }

      const show =
        matchesSearch &&
        matchesType;

      row.dataset.hidden =
        show ? 'false' : 'true';

      if (show) {
        visible++;
      }
    });

    if (count) {
      count.textContent =
        visible === rows.length
          ? `${visible} ${
              visible === 1
                ? 'registro'
                : 'registros'
            }`
          : `${visible} de ${rows.length} registros`;
    }

    if (noResults) {
      noResults.hidden = !(
        rows.length > 0 &&
        visible === 0
      );
    }
  }

  filterButtons.forEach((button) => {
    button.addEventListener(
      'click',
      () => {
        selectedType =
          button.dataset.filter ?? '';

        filterButtons.forEach(
          (b) => {
            b.setAttribute(
              'aria-pressed',
              String(
                b === button
              )
            );
          }
        );

        applyFilters();
      }
    );
  });

  search?.addEventListener(
    'input',
    applyFilters
  );

  /* ========================================================
     ATAJOS
     ======================================================== */

  document.addEventListener(
    'keydown',
    (event) => {
      const target =
        event.target as HTMLElement | null;

      const typing =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement;

      /* "/" → enfocar búsqueda */

      if (
        event.key === '/' &&
        !typing
      ) {
        event.preventDefault();

        search?.focus();
      }

      /* ESC → limpiar búsqueda */

      if (
        event.key === 'Escape' &&
        target === search &&
        search
      ) {
        search.value = '';

        applyFilters();

        search.blur();
      }
    }
  );
</script>