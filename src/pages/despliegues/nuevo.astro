---
import OperatorLayout from '../../layouts/OperatorLayout.astro';
import { getCurrentMember } from '../../lib/auth';

const {
  member,
} = await getCurrentMember(Astro);

if (!member) {
  return Astro.redirect('/login');
}
---

<OperatorLayout
  title="Nuevo despliegue"
  active="operaciones"
>
  <main class="space-y-6">

    <!-- HEADER -->

    <section class="border border-base-600 bg-base-900 p-6">

      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">

        <div>
          <p class="font-mono text-xs uppercase tracking-[0.25em] text-gold-500">
            SRT / OPERACIONES
          </p>

          <h1 class="mt-2 font-display text-3xl uppercase tracking-wide text-bone-100">
            Nuevo despliegue
          </h1>

          <p class="mt-2 max-w-2xl text-sm text-silver-300">
            Registrar una nueva intervención operativa.
            Los datos del Alpha, código y timestamps
            serán gestionados automáticamente por el sistema.
          </p>
        </div>

        <a
          href="/despliegues"
          class="border border-base-600 px-4 py-2 text-xs font-mono uppercase tracking-wider text-silver-300 transition hover:border-gold-500 hover:text-gold-500"
        >
          ← Volver
        </a>

      </div>

    </section>


    <!-- FORMULARIO -->

    <form
      id="deployment-form"
      class="space-y-6"
    >

      <!-- INFORMACIÓN GENERAL -->

      <section class="border border-base-600 bg-base-900">

        <div class="border-b border-base-600 px-6 py-4">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-500">
            01 / Información general
          </p>
        </div>

        <div class="grid gap-6 p-6 md:grid-cols-2">

          <!-- TITULO -->

          <div class="md:col-span-2">

            <label
              for="title"
              class="mb-2 block font-mono text-xs uppercase tracking-wider text-silver-300"
            >
              Título del despliegue
            </label>

            <input
              id="title"
              name="title"
              type="text"
              required
              placeholder="Ej. Atrincheramiento Vehicular Sandy Shores"
              class="w-full border border-base-600 bg-base-950 px-4 py-3 text-sm text-bone-100 outline-none transition placeholder:text-silver-500 focus:border-gold-500"
            />

          </div>


          <!-- TIPO -->

          <div>

            <label
              for="type"
              class="mb-2 block font-mono text-xs uppercase tracking-wider text-silver-300"
            >
              Tipo de despliegue
            </label>

            <select
              id="type"
              name="type"
              required
              class="w-full border border-base-600 bg-base-950 px-4 py-3 text-sm text-bone-100 outline-none focus:border-gold-500"
            >

              <option value="">
                Seleccionar tipo
              </option>

              <option value="Atrincheramiento con rehenes">
                Atrincheramiento con rehenes
              </option>

              <option value="Atrincheramiento involuntario">
                Atrincheramiento involuntario
              </option>

              <option value="Atrincheramiento vehicular">
                Atrincheramiento vehicular
              </option>

              <option value="Emboscada">
                Emboscada
              </option>

              <option value="Allanamiento">
                Allanamiento
              </option>

              <option value="Secuestro">
                Secuestro
              </option>

            </select>

          </div>


          <!-- UBICACIÓN -->

          <div>

            <label
              for="location"
              class="mb-2 block font-mono text-xs uppercase tracking-wider text-silver-300"
            >
              Ubicación
            </label>

            <input
              id="location"
              name="location"
              type="text"
              required
              placeholder="Ej. Sandy Shores"
              class="w-full border border-base-600 bg-base-950 px-4 py-3 text-sm text-bone-100 outline-none transition placeholder:text-silver-500 focus:border-gold-500"
            />

          </div>


          <!-- ALPHA -->

          <div>

            <label
              class="mb-2 block font-mono text-xs uppercase tracking-wider text-silver-300"
            >
              Alpha
            </label>

            <div class="border border-base-600 bg-base-950 px-4 py-3">

              <div class="flex items-center gap-3">

                {member.photo_url ? (
                  <img
                    src={member.photo_url}
                    alt=""
                    class="h-10 w-10 rounded-full object-cover"
                  />
                ) : (
                  <div class="flex h-10 w-10 items-center justify-center rounded-full border border-base-600 bg-base-800 font-mono text-xs text-gold-500">
                    {member.full_name?.slice(0, 1) ?? '?'}
                  </div>
                )}

                <div>
                  <p class="text-sm text-bone-100">
                    {member.full_name}
                  </p>

                  <p class="font-mono text-xs text-silver-400">
                    {member.callsign ?? 'SIN CALLSIGN'}
                  </p>
                </div>

              </div>

            </div>

          </div>

        </div>

      </section>


      <!-- PARTICIPANTES -->

      <section class="border border-base-600 bg-base-900">

        <div class="border-b border-base-600 px-6 py-4">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-500">
            02 / Operadores
          </p>
        </div>

        <div class="p-6">

          <label
            for="operator-search"
            class="mb-2 block font-mono text-xs uppercase tracking-wider text-silver-300"
          >
            Buscar operador
          </label>

          <input
            id="operator-search"
            type="text"
            placeholder="Buscar por nombre o callsign..."
            class="mb-4 w-full border border-base-600 bg-base-950 px-4 py-3 text-sm text-bone-100 outline-none placeholder:text-silver-500 focus:border-gold-500"
          />

          <div
            id="operators-list"
            class="grid gap-2 md:grid-cols-2"
          >
            <div class="border border-base-600 bg-base-950 p-4 text-sm text-silver-400">
              Cargando operadores...
            </div>
          </div>

        </div>

      </section>


      <!-- RESUMEN -->

      <section class="border border-base-600 bg-base-900">

        <div class="border-b border-base-600 px-6 py-4">
          <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-500">
            03 / Resumen general
          </p>
        </div>

        <div class="p-6">

          <label
            for="description"
            class="mb-2 block font-mono text-xs uppercase tracking-wider text-silver-300"
          >
            Resumen general
          </label>

          <textarea
            id="description"
            rows="7"
            placeholder="Describí el desarrollo de la situación desde el inicio hasta su finalización."
            class="w-full resize-y border border-base-600 bg-base-950 px-4 py-3 text-sm text-bone-100 outline-none placeholder:text-silver-500 focus:border-gold-500"
          ></textarea>

        </div>

      </section>


      <!-- SOSPECHOSOS -->

      <section class="border border-base-600 bg-base-900">

        <div class="flex items-center justify-between border-b border-base-600 px-6 py-4">

          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-500">
              04 / Sospechosos
            </p>

            <p class="mt-1 text-xs text-silver-500">
              Identificación y objetos incautados.
            </p>
          </div>

          <button
            type="button"
            id="add-suspect"
            class="border border-base-600 px-3 py-2 font-mono text-xs uppercase tracking-wider text-silver-300 transition hover:border-gold-500 hover:text-gold-500"
          >
            + Agregar
          </button>

        </div>

        <div
          id="suspects-container"
          class="space-y-3 p-6"
        >
          <p class="text-sm text-silver-500">
            No se agregaron sospechosos.
          </p>
        </div>

      </section>


      <!-- VEHICULOS -->

      <section class="border border-base-600 bg-base-900">

        <div class="flex items-center justify-between border-b border-base-600 px-6 py-4">

          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-500">
              05 / Vehículos utilizados
            </p>
          </div>

          <button
            type="button"
            id="add-vehicle"
            class="border border-base-600 px-3 py-2 font-mono text-xs uppercase tracking-wider text-silver-300 transition hover:border-gold-500 hover:text-gold-500"
          >
            + Agregar
          </button>

        </div>

        <div
          id="vehicles-container"
          class="space-y-3 p-6"
        >
          <p class="text-sm text-silver-500">
            No se agregaron vehículos.
          </p>
        </div>

      </section>


      <!-- MATERIAL -->

      <section class="border border-base-600 bg-base-900">

        <div class="flex items-center justify-between border-b border-base-600 px-6 py-4">

          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-500">
              06 / Material utilizado
            </p>
          </div>

          <button
            type="button"
            id="add-equipment"
            class="border border-base-600 px-3 py-2 font-mono text-xs uppercase tracking-wider text-silver-300 transition hover:border-gold-500 hover:text-gold-500"
          >
            + Agregar
          </button>

        </div>

        <div
          id="equipment-container"
          class="space-y-3 p-6"
        >
          <p class="text-sm text-silver-500">
            No se agregó material.
          </p>
        </div>

      </section>


      <!-- GRABACIONES -->

      <section class="border border-base-600 bg-base-900">

        <div class="flex items-center justify-between border-b border-base-600 px-6 py-4">

          <div>
            <p class="font-mono text-xs uppercase tracking-[0.2em] text-gold-500">
              07 / Grabaciones
            </p>
          </div>

          <button
            type="button"
            id="add-recording"
            class="border border-base-600 px-3 py-2 font-mono text-xs uppercase tracking-wider text-silver-300 transition hover:border-gold-500 hover:text-gold-500"
          >
            + Agregar
          </button>

        </div>

        <div
          id="recordings-container"
          class="space-y-3 p-6"
        >
          <p class="text-sm text-silver-500">
            No se agregaron grabaciones.
          </p>
        </div>

      </section>


      <!-- ACCIONES -->

      <section class="flex flex-col-reverse gap-3 border border-base-600 bg-base-900 p-6 sm:flex-row sm:justify-end">

        <a
          href="/despliegues"
          class="border border-base-600 px-6 py-3 text-center font-mono text-xs uppercase tracking-wider text-silver-300 transition hover:border-base-400 hover:text-bone-100"
        >
          Cancelar
        </a>

        <button
          type="submit"
          id="submit-button"
          class="bg-gold-500 px-6 py-3 font-mono text-xs uppercase tracking-wider text-base-950 transition hover:bg-gold-400 disabled:cursor-not-allowed disabled:opacity-50"
        >
          Crear despliegue
        </button>

      </section>

    </form>

  </main>


  <script>
    const form =
      document.querySelector<HTMLFormElement>(
        '#deployment-form'
      );

    const submitButton =
      document.querySelector<HTMLButtonElement>(
        '#submit-button'
      );

    const operatorsList =
      document.querySelector<HTMLDivElement>(
        '#operators-list'
      );

    const operatorSearch =
      document.querySelector<HTMLInputElement>(
        '#operator-search'
      );

    const suspectsContainer =
      document.querySelector<HTMLDivElement>(
        '#suspects-container'
      );

    const vehiclesContainer =
      document.querySelector<HTMLDivElement>(
        '#vehicles-container'
      );

    const equipmentContainer =
      document.querySelector<HTMLDivElement>(
        '#equipment-container'
      );

    const recordingsContainer =
      document.querySelector<HTMLDivElement>(
        '#recordings-container'
      );


    // =========================================================
    // OPERADORES
    // =========================================================

    type Member = {
      id: string;
      full_name: string | null;
      callsign: string | null;
      photo_url: string | null;
      rank?: {
        name: string;
      } | null;
    };

    let members: Member[] = [];

    async function loadMembers() {
      if (!operatorsList) return;

      try {
        const response = await fetch(
          '/api/miembros'
        );

        if (!response.ok) {
          throw new Error(
            'No se pudieron cargar los operadores.'
          );
        }

        members = await response.json();

        renderMembers();

      } catch (error) {
        console.error(error);

        operatorsList.innerHTML = `
          <div class="border border-danger-500/40 bg-danger-500/5 p-4 text-sm text-danger-500">
            No se pudieron cargar los operadores.
          </div>
        `;
      }
    }

    function renderMembers() {
      if (!operatorsList) return;

      const search =
        operatorSearch?.value
          .trim()
          .toLowerCase() ?? '';

      const filtered =
        members.filter((member) => {

          const text = [
            member.full_name ?? '',
            member.callsign ?? '',
            member.rank?.name ?? '',
          ]
            .join(' ')
            .toLowerCase();

          return text.includes(search);
        });

      if (filtered.length === 0) {
        operatorsList.innerHTML = `
          <div class="border border-base-600 bg-base-950 p-4 text-sm text-silver-500">
            No se encontraron operadores.
          </div>
        `;

        return;
      }

      operatorsList.innerHTML =
        filtered
          .map((member) => {

            const checked =
              member.id ===
              '${member.id}';

            return `
              <label
                class="flex cursor-pointer items-center gap-3 border border-base-600 bg-base-950 p-4 transition hover:border-gold-500"
              >

                <input
                  type="checkbox"
                  value="${member.id}"
                  class="operator-checkbox h-4 w-4 accent-yellow-500"
                />

                ${
                  member.photo_url
                    ? `
                      <img
                        src="${member.photo_url}"
                        alt=""
                        class="h-10 w-10 rounded-full object-cover"
                      />
                    `
                    : `
                      <div class="flex h-10 w-10 items-center justify-center rounded-full border border-base-600 bg-base-800 font-mono text-xs text-gold-500">
                        ${(member.full_name ?? '?').slice(0, 1)}
                      </div>
                    `
                }

                <div class="min-w-0">

                  <p class="truncate text-sm text-bone-100">
                    ${member.full_name ?? 'Sin nombre'}
                  </p>

                  <p class="font-mono text-xs text-silver-500">
                    ${member.callsign ?? 'SIN CALLSIGN'}
                    ${
                      member.rank?.name
                        ? ` · ${member.rank.name}`
                        : ''
                    }
                  </p>

                </div>

              </label>
            `;
          })
          .join('');
    }

    operatorSearch?.addEventListener(
      'input',
      renderMembers
    );


    // =========================================================
    // HELPERS DINÁMICOS
    // =========================================================

    function emptyMessage(
      container: HTMLElement,
      message: string
    ) {
      if (
        container.children.length === 0
      ) {
        container.innerHTML = `
          <p class="text-sm text-silver-500">
            ${message}
          </p>
        `;
      }
    }

    function removeEmptyMessage(
      container: HTMLElement
    ) {
      const message =
        container.querySelector(
          ':scope > p.text-silver-500'
        );

      message?.remove();
    }


    // =========================================================
    // SOSPECHOSOS
    // =========================================================

    document
      .querySelector<HTMLButtonElement>(
        '#add-suspect'
      )
      ?.addEventListener(
        'click',
        () => {

          if (!suspectsContainer)
            return;

          removeEmptyMessage(
            suspectsContainer
          );

          const row =
            document.createElement(
              'div'
            );

          row.className =
            'grid gap-3 border border-base-600 bg-base-950 p-4 md:grid-cols-[1fr_1fr_auto]';

          row.innerHTML = `

            <input
              type="text"
              data-identification
              placeholder="Identificación"
              class="w-full border border-base-600 bg-base-900 px-4 py-3 text-sm text-bone-100 outline-none placeholder:text-silver-500 focus:border-gold-500"
            />

            <input
              type="text"
              data-confiscated
              placeholder="Objetos incautados"
              class="w-full border border-base-600 bg-base-900 px-4 py-3 text-sm text-bone-100 outline-none placeholder:text-silver-500 focus:border-gold-500"
            />

            <button
              type="button"
              data-remove
              class="border border-base-600 px-4 py-2 font-mono text-xs uppercase text-silver-400 hover:border-danger-500 hover:text-danger-500"
            >
              Eliminar
            </button>

          `;

          row
            .querySelector<HTMLButtonElement>(
              '[data-remove]'
            )
            ?.addEventListener(
              'click',
              () => {
                row.remove();

                emptyMessage(
                  suspectsContainer,
                  'No se agregaron sospechosos.'
                );
              }
            );

          suspectsContainer.appendChild(
            row
          );
        }
      );


    // =========================================================
    // VEHÍCULOS
    // =========================================================

    document
      .querySelector<HTMLButtonElement>(
        '#add-vehicle'
      )
      ?.addEventListener(
        'click',
        () => {

          if (!vehiclesContainer)
            return;

          removeEmptyMessage(
            vehiclesContainer
          );

          const row =
            document.createElement(
              'div'
            );

          row.className =
            'flex gap-3 border border-base-600 bg-base-950 p-4';

          row.innerHTML = `

            <input
              type="text"
              data-description
              placeholder="Ej. Dodge Charger negro - B32"
              class="min-w-0 flex-1 border border-base-600 bg-base-900 px-4 py-3 text-sm text-bone-100 outline-none placeholder:text-silver-500 focus:border-gold-500"
            />

            <button
              type="button"
              data-remove
              class="border border-base-600 px-4 py-2 font-mono text-xs uppercase text-silver-400 hover:border-danger-500 hover:text-danger-500"
            >
              Eliminar
            </button>

          `;

          row
            .querySelector<HTMLButtonElement>(
              '[data-remove]'
            )
            ?.addEventListener(
              'click',
              () => {
                row.remove();

                emptyMessage(
                  vehiclesContainer,
                  'No se agregaron vehículos.'
                );
              }
            );

          vehiclesContainer.appendChild(
            row
          );
        }
      );


    // =========================================================
    // EQUIPMENT
    // =========================================================

    document
      .querySelector<HTMLButtonElement>(
        '#add-equipment'
      )
      ?.addEventListener(
        'click',
        () => {

          if (!equipmentContainer)
            return;

          removeEmptyMessage(
            equipmentContainer
          );

          const row =
            document.createElement(
              'div'
            );

          row.className =
            'flex gap-3 border border-base-600 bg-base-950 p-4';

          row.innerHTML = `

            <input
              type="text"
              data-description
              placeholder="Ej. Escudo balístico, rifle, dron..."
              class="min-w-0 flex-1 border border-base-600 bg-base-900 px-4 py-3 text-sm text-bone-100 outline-none placeholder:text-silver-500 focus:border-gold-500"
            />

            <button
              type="button"
              data-remove
              class="border border-base-600 px-4 py-2 font-mono text-xs uppercase text-silver-400 hover:border-danger-500 hover:text-danger-500"
            >
              Eliminar
            </button>

          `;

          row
            .querySelector<HTMLButtonElement>(
              '[data-remove]'
            )
            ?.addEventListener(
              'click',
              () => {
                row.remove();

                emptyMessage(
                  equipmentContainer,
                  'No se agregó material.'
                );
              }
            );

          equipmentContainer.appendChild(
            row
          );
        }
      );


    // =========================================================
    // GRABACIONES
    // =========================================================

    document
      .querySelector<HTMLButtonElement>(
        '#add-recording'
      )
      ?.addEventListener(
        'click',
        () => {

          if (!recordingsContainer)
            return;

          removeEmptyMessage(
            recordingsContainer
          );

          const row =
            document.createElement(
              'div'
            );

          row.className =
            'flex gap-3 border border-base-600 bg-base-950 p-4';

          row.innerHTML = `

            <input
              type="url"
              data-url
              placeholder="https://..."
              class="min-w-0 flex-1 border border-base-600 bg-base-900 px-4 py-3 text-sm text-bone-100 outline-none placeholder:text-silver-500 focus:border-gold-500"
            />

            <button
              type="button"
              data-remove
              class="border border-base-600 px-4 py-2 font-mono text-xs uppercase text-silver-400 hover:border-danger-500 hover:text-danger-500"
            >
              Eliminar
            </button>

          `;

          row
            .querySelector<HTMLButtonElement>(
              '[data-remove]'
            )
            ?.addEventListener(
              'click',
              () => {
                row.remove();

                emptyMessage(
                  recordingsContainer,
                  'No se agregaron grabaciones.'
                );
              }
            );

          recordingsContainer.appendChild(
            row
          );
        }
      );


    // =========================================================
    // SUBMIT
    // =========================================================

    form?.addEventListener(
      'submit',
      async (event) => {

        event.preventDefault();

        if (!submitButton)
          return;

        submitButton.disabled = true;
        submitButton.textContent =
          'CREANDO...';

        try {

          const title =
            document
              .querySelector<HTMLInputElement>(
                '#title'
              )
              ?.value
              .trim() ?? '';

          const type =
            document
              .querySelector<HTMLSelectElement>(
                '#type'
              )
              ?.value
              .trim() ?? '';

          const location =
            document
              .querySelector<HTMLInputElement>(
                '#location'
              )
              ?.value
              .trim() ?? '';

          const description =
            document
              .querySelector<HTMLTextAreaElement>(
                '#description'
              )
              ?.value
              .trim() ?? '';


          // OPERADORES

          const operatorCheckboxes =
            Array.from(
              document.querySelectorAll<HTMLInputElement>(
                '.operator-checkbox:checked'
              )
            );

          const operators =
            operatorCheckboxes.map(
              (checkbox) => ({
                memberId: checkbox.value,
              })
            );


          // SOSPECHOSOS

          const suspects =
            suspectsContainer
              ? Array.from(
                  suspectsContainer.querySelectorAll<HTMLElement>(
                    '[data-identification]'
                  )
                )
                  .map((element) => {

                    const row =
                      element.parentElement;

                    const identification =
                      (
                        element as HTMLInputElement
                      ).value.trim();

                    const confiscatedItems =
                      row?.querySelector<HTMLInputElement>(
                        '[data-confiscated]'
                      )?.value.trim() ?? '';

                    return {
                      identification,
                      confiscatedItems,
                    };
                  })
                  .filter(
                    (suspect) =>
                      suspect.identification ||
                      suspect.confiscatedItems
                  )
              : [];


          // VEHÍCULOS

          const vehicles =
            vehiclesContainer
              ? Array.from(
                  vehiclesContainer.querySelectorAll<HTMLInputElement>(
                    '[data-description]'
                  )
                )
                  .map((input) => ({
                    description:
                      input.value.trim(),
                  }))
                  .filter(
                    (vehicle) =>
                      vehicle.description
                  )
              : [];


          // EQUIPO

          const equipment =
            equipmentContainer
              ? Array.from(
                  equipmentContainer.querySelectorAll<HTMLInputElement>(
                    '[data-description]'
                  )
                )
                  .map((input) => ({
                    description:
                      input.value.trim(),
                  }))
                  .filter(
                    (item) =>
                      item.description
                  )
              : [];


          // GRABACIONES

          const recordings =
            recordingsContainer
              ? Array.from(
                  recordingsContainer.querySelectorAll<HTMLInputElement>(
                    '[data-url]'
                  )
                )
                  .map((input) => ({
                    url:
                      input.value.trim(),
                  }))
                  .filter(
                    (recording) =>
                      recording.url
                  )
              : [];


          // VALIDACIÓN

          if (!title) {
            throw new Error(
              'Ingresá un título.'
            );
          }

          if (!type) {
            throw new Error(
              'Seleccioná un tipo de despliegue.'
            );
          }

          if (!location) {
            throw new Error(
              'Ingresá una ubicación.'
            );
          }


          // REQUEST

          const response =
            await fetch(
              '/api/despliegues',
              {
                method: 'POST',

                headers: {
                  'Content-Type':
                    'application/json',
                },

                credentials: 'same-origin',

                body: JSON.stringify({
                  title,
                  type,
                  location,
                  description:
                    description || null,
                  operators,
                  suspects,
                  vehicles,
                  equipment,
                  recordings,
                }),
              }
            );


          // LEER RESPUESTA COMO TEXTO
          // PARA EVITAR EL ERROR "<"

          const responseText =
            await response.text();

          console.log(
            'DEPLOYMENT RESPONSE:',
            response.status,
            responseText
          );


          let result: any = null;

          try {
            result =
              JSON.parse(
                responseText
              );
          } catch {
            throw new Error(
              `El servidor devolvió una respuesta inválida (${response.status}).`
            );
          }


          if (
            !response.ok ||
            !result?.success
          ) {
            throw new Error(
              result?.error ??
              'No se pudo crear el despliegue.'
            );
          }


          // ÉXITO

          window.location.href =
            `/despliegues/${result.id}`;

        } catch (error) {

          console.error(
            'CREATE DEPLOYMENT ERROR:',
            error
          );

          alert(
            error instanceof Error
              ? error.message
              : 'Ocurrió un error al crear el despliegue.'
          );

          submitButton.disabled =
            false;

          submitButton.textContent =
            'CREAR DESPLIEGUE';
        }
      }
    );


    // =========================================================
    // INICIALIZAR
    // =========================================================

    loadMembers();
  </script>
</OperatorLayout>