---
import OperatorLayout from '../../../layouts/OperatorLayout.astro';
import { getCurrentMember } from '../../../lib/auth';
import { createApiClient } from '../../../lib/supabase-api';

const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/despliegues');
}

const { member, permissions } =
  await getCurrentMember(Astro);

if (!member) {
  return Astro.redirect('/login');
}

const supabase = createApiClient(Astro.request, Astro.cookies);

const isLeader =
  permissions.includes('admin.access');


// =====================================================
// DESPLIEGUE
// =====================================================

const {
  data: deployment,
  error: deploymentError,
} = await supabase
  .from('deployments')
  .select(`
    id,
    code,
    title,
    type,
    location,
    status,
    report_status,
    description,
    created_at,
    updated_at,
    created_by,
    reviewed_by,
    reviewed_at,

    members:created_by (
      id,
      full_name,
      callsign,
      photo_url,
      rank_id
    )
  `)
  .eq('id', id)
  .single();


if (deploymentError || !deployment) {
  console.error(
    'DEPLOYMENT DETAIL ERROR:',
    deploymentError
  );

  return Astro.redirect('/despliegues');
}


const currentDeployment = deployment;


// =====================================================
// PARTICIPANTES
// =====================================================

const {
  data: participants,
  error: participantsError,
} = await supabase
  .from('deployment_members')
  .select(`
    id,
    role,
    member_id,
    members (
      id,
      full_name,
      callsign,
      photo_url,
      rank_id
    )
  `)
  .eq('deployment_id', currentDeployment.id)
  .order('role', {
    ascending: true,
  });


if (participantsError) {
  console.error(
    'PARTICIPANTS ERROR:',
    participantsError
  );
}


// =====================================================
// SOSPECHOSOS
// =====================================================

const {
  data: suspects,
  error: suspectsError,
} = await supabase
  .from('deployment_suspects')
  .select(`
    id,
    identification,
    confiscated_items,
    status,
    notes,
    created_at
  `)
  .eq('deployment_id', currentDeployment.id)
  .order('id', {
    ascending: true,
  });


if (suspectsError) {
  console.error(
    'SUSPECTS ERROR:',
    suspectsError
  );
}


// =====================================================
// VEHÍCULOS
// =====================================================

const {
  data: vehicles,
  error: vehiclesError,
} = await supabase
  .from('deployment_vehicles')
  .select(`
    id,
    description,
    created_at
  `)
  .eq('deployment_id', currentDeployment.id)
  .order('id', {
    ascending: true,
  });


if (vehiclesError) {
  console.error(
    'VEHICLES ERROR:',
    vehiclesError
  );
}


// =====================================================
// EQUIPAMIENTO
// =====================================================

const {
  data: equipment,
  error: equipmentError,
} = await supabase
  .from('deployment_equipment')
  .select(`
    id,
    description,
    created_at
  `)
  .eq('deployment_id', currentDeployment.id)
  .order('id', {
    ascending: true,
  });


if (equipmentError) {
  console.error(
    'EQUIPMENT ERROR:',
    equipmentError
  );
}


// =====================================================
// GRABACIONES
// =====================================================

const {
  data: recordings,
  error: recordingsError,
} = await supabase
  .from('deployment_recordings')
  .select(`
    id,
    url,
    created_at
  `)
  .eq('deployment_id', currentDeployment.id)
  .order('id', {
    ascending: true,
  });


if (recordingsError) {
  console.error(
    'RECORDINGS ERROR:',
    recordingsError
  );
}


// =====================================================
// REVISOR
// =====================================================

let reviewer: {
  full_name: string | null;
  callsign: string | null;
} | null = null;


if (currentDeployment.reviewed_by) {
  const {
    data: reviewerData,
    error: reviewerError,
  } = await supabase
    .from('members')
    .select(`
      full_name,
      callsign
    `)
    .eq(
      'id',
      currentDeployment.reviewed_by
    )
    .single();


  if (reviewerError) {
    console.error(
      'REVIEWER ERROR:',
      reviewerError
    );
  }


  reviewer = reviewerData;
}


// =====================================================
// HELPERS
// =====================================================

const formatDate = (
  value: string | null
) => {
  if (!value) return '—';

  return new Intl.DateTimeFormat(
    'es-PY',
    {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
    }
  ).format(new Date(value));
};


const formatShortDate = (
  value: string | null
) => {
  if (!value) return '—';

  return new Intl.DateTimeFormat(
    'es-PY',
    {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
    }
  ).format(new Date(value));
};


const getMemberName = (
  memberData: any
) => {
  if (!memberData) return 'Desconocido';

  return (
    memberData.full_name ||
    memberData.callsign ||
    'Sin identificar'
  );
};


const getCallsign = (
  memberData: any
) => {
  if (!memberData) return '—';

  return memberData.callsign
    ? memberData.callsign
    : '—';
};


const isReviewed =
  currentDeployment.report_status ===
  'reviewed';

const reportStatusLabel = isReviewed
  ? 'REVISADO'
  : 'EN ESPERA DE REVISIÓN';

const reportStatusClass = isReviewed
  ? 'border-green-500/30 bg-green-500/10 text-green-400'
  : 'border-gold-500/30 bg-gold-500/10 text-gold-400';
---

<OperatorLayout
  title={currentDeployment.title}
  active="operaciones"
>

  <div class="space-y-6">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <section
      class="relative overflow-hidden border border-base-600 bg-base-900"
    >

      <div class="absolute inset-0 tac-grid opacity-30"></div>

      <div class="relative p-6 md:p-8">

        <!-- Breadcrumb -->

        <div
          class="mb-6 flex items-center gap-2 text-[10px] font-mono uppercase tracking-[0.2em] text-silver-500"
        >
          <a
            href="/despliegues"
            class="transition hover:text-gold-500"
          >
            DESPLIEGUES
          </a>

          <span>/</span>

          <span>
            {currentDeployment.code}
          </span>
        </div>


        <!-- Title -->

        <div
          class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between"
        >

          <div>

            <div
              class="mb-3 flex flex-wrap items-center gap-3"
            >

              <span
                class="border border-green-500/30 bg-green-500/10 px-3 py-1 text-[10px] font-mono font-bold tracking-[0.15em] text-green-400"
              >
                OPERACIÓN COMPLETADA
              </span>

              <span
                class={`border px-3 py-1 text-[10px] font-mono font-bold tracking-[0.15em] ${reportStatusClass}`}
              >
                {reportStatusLabel}
              </span>

            </div>


            <h1
              class="font-display text-3xl font-black uppercase tracking-tight text-bone-100 md:text-5xl"
            >
              {currentDeployment.title}
            </h1>


            <div
              class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-mono text-silver-400"
            >

              <span>
                {currentDeployment.code}
              </span>

              <span class="text-base-600">
                //
              </span>

              <span>
                {currentDeployment.type}
              </span>

              <span class="text-base-600">
                //
              </span>

              <span>
                {currentDeployment.location}
              </span>

            </div>

          </div>


          <!-- Review action -->

          {
            !isReviewed && isLeader && (
              <button
                id="review-button"
                type="button"
                class="group flex shrink-0 items-center justify-center gap-3 border border-gold-500 bg-gold-500 px-5 py-3 text-xs font-black tracking-[0.12em] text-base-950 transition hover:bg-gold-400"
              >

                <span>
                  ✓
                </span>

                <span>
                  MARCAR COMO REVISADO
                </span>

              </button>
            )
          }

        </div>

      </div>

    </section>


    <!-- ================================================= -->
    <!-- META -->
    <!-- ================================================= -->

    <section
      class="grid grid-cols-1 gap-px border border-base-600 bg-base-600 sm:grid-cols-2 lg:grid-cols-4"
    >

      <!-- CREATED -->

      <div class="bg-base-900 p-5">

        <div
          class="mb-2 text-[9px] font-mono font-bold tracking-[0.2em] text-silver-500"
        >
          INFORME CREADO
        </div>

        <div
          class="font-mono text-sm font-bold text-bone-100"
        >
          {formatShortDate(
            currentDeployment.created_at
          )}
        </div>

        <div
          class="mt-1 text-[10px] font-mono text-silver-500"
        >
          {formatDate(
            currentDeployment.created_at
          )}
        </div>

      </div>


      <!-- ALPHA -->

      <div class="bg-base-900 p-5">

        <div
          class="mb-2 text-[9px] font-mono font-bold tracking-[0.2em] text-silver-500"
        >
          ALPHA RESPONSABLE
        </div>

        <div
          class="font-mono text-sm font-bold text-bone-100"
        >
          {getCallsign(
            currentDeployment.members
          )}
        </div>

        <div
          class="mt-1 truncate text-[10px] font-mono text-silver-500"
        >
          {getMemberName(
            currentDeployment.members
          )}
        </div>

      </div>


      <!-- LOCATION -->

      <div class="bg-base-900 p-5">

        <div
          class="mb-2 text-[9px] font-mono font-bold tracking-[0.2em] text-silver-500"
        >
          UBICACIÓN
        </div>

        <div
          class="truncate font-mono text-sm font-bold uppercase text-bone-100"
        >
          {currentDeployment.location}
        </div>

      </div>


      <!-- REPORT -->

      <div class="bg-base-900 p-5">

        <div
          class="mb-2 text-[9px] font-mono font-bold tracking-[0.2em] text-silver-500"
        >
          ESTADO DEL INFORME
        </div>

        <div
          class={`font-mono text-sm font-bold ${
            isReviewed
              ? 'text-green-400'
              : 'text-gold-400'
          }`}
        >
          {reportStatusLabel}
        </div>

        {
          isReviewed && currentDeployment.reviewed_at && (
            <div
              class="mt-1 text-[10px] font-mono text-silver-500"
            >
              {formatDate(
                currentDeployment.reviewed_at
              )}
            </div>
          )
        }

      </div>

    </section>


    <!-- ================================================= -->
    <!-- REVISIÓN -->
    <!-- ================================================= -->

    {
      isReviewed && (
        <section
          class="border border-green-500/20 bg-green-500/5"
        >

          <div class="p-5">

            <div
              class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between"
            >

              <div>

                <div
                  class="text-[9px] font-mono font-bold tracking-[0.2em] text-green-400"
                >
                  ✓ INFORME REVISADO
                </div>

                <div
                  class="mt-2 font-display text-lg font-bold uppercase text-bone-100"
                >
                  Este despliegue fue validado por un líder.
                </div>

              </div>


              {
                reviewer && (
                  <div
                    class="text-left sm:text-right"
                  >

                    <div
                      class="text-[9px] font-mono tracking-[0.15em] text-silver-500"
                    >
                      REVISADO POR
                    </div>

                    <div
                      class="mt-1 font-mono text-sm font-bold text-bone-100"
                    >
                      {reviewer.callsign
                        ? `${reviewer.callsign} — `
                        : ''}
                      {reviewer.full_name ||
                        'Líder SRT'}
                    </div>

                    {
                      currentDeployment.reviewed_at && (
                        <div
                          class="mt-1 text-[10px] font-mono text-silver-500"
                        >
                          {formatDate(
                            currentDeployment.reviewed_at
                          )}
                        </div>
                      )
                    }

                  </div>
                )
              }

            </div>

          </div>

        </section>
      )
    }


    <!-- ================================================= -->
    <!-- RESUMEN -->
    <!-- ================================================= -->

    <section
      class="border border-base-600 bg-base-900"
    >

      <div
        class="border-b border-base-600 px-5 py-4"
      >

        <div
          class="text-[10px] font-mono font-bold tracking-[0.2em] text-gold-500"
        >
          01 // RESUMEN GENERAL
        </div>

      </div>


      <div class="p-5 md:p-6">

        {
          currentDeployment.description ? (
            <p
              class="whitespace-pre-wrap text-sm leading-7 text-silver-300"
            >
              {currentDeployment.description}
            </p>
          ) : (
            <div
              class="text-xs font-mono text-silver-500"
            >
              SIN RESUMEN REGISTRADO.
            </div>
          )
        }

      </div>

    </section>


    <!-- ================================================= -->
    <!-- PERSONAL -->
    <!-- ================================================= -->

    <section
      class="border border-base-600 bg-base-900"
    >

      <div
        class="border-b border-base-600 px-5 py-4"
      >

        <div
          class="text-[10px] font-mono font-bold tracking-[0.2em] text-gold-500"
        >
          02 // PERSONAL PARTICIPANTE
        </div>

      </div>


      <div class="p-5">

        {
          participants && participants.length > 0 ? (
            <div
              class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3"
            >

              {
                participants.map((participant: any) => {

                  const participantMember =
                    Array.isArray(
                      participant.members
                    )
                      ? participant.members[0]
                      : participant.members;

                  const isAlpha =
                    participant.role === 'alpha';

                  return (
                    <div
                      class={`border p-4 ${
                        isAlpha
                          ? 'border-gold-500/30 bg-gold-500/5'
                          : 'border-base-600 bg-base-950'
                      }`}
                    >

                      <div
                        class="flex items-center justify-between gap-3"
                      >

                        <div>

                          <div
                            class="font-mono text-sm font-bold text-bone-100"
                          >
                            {getCallsign(
                              participantMember
                            )}
                          </div>

                          <div
                            class="mt-1 text-xs text-silver-400"
                          >
                            {getMemberName(
                              participantMember
                            )}
                          </div>

                        </div>


                        <span
                          class={`text-[9px] font-mono font-bold tracking-[0.15em] ${
                            isAlpha
                              ? 'text-gold-400'
                              : 'text-silver-500'
                          }`}
                        >
                          {isAlpha
                            ? 'ALPHA'
                            : 'OPERADOR'}
                        </span>

                      </div>

                    </div>
                  );

                })
              }

            </div>
          ) : (
            <div
              class="text-xs font-mono text-silver-500"
            >
              SIN PERSONAL REGISTRADO.
            </div>
          )
        }

      </div>

    </section>


    <!-- ================================================= -->
    <!-- SOSPECHOSOS -->
    <!-- ================================================= -->

    <section
      class="border border-base-600 bg-base-900"
    >

      <div
        class="border-b border-base-600 px-5 py-4"
      >

        <div
          class="text-[10px] font-mono font-bold tracking-[0.2em] text-gold-500"
        >
          03 // SOSPECHOSOS
        </div>

      </div>


      <div class="p-5">

        {
          suspects && suspects.length > 0 ? (
            <div class="space-y-3">

              {
                suspects.map((suspect: any, index: number) => (
                  <div
                    class="border border-base-600 bg-base-950 p-4"
                  >

                    <div
                      class="grid gap-4 md:grid-cols-2"
                    >

                      <div>

                        <div
                          class="mb-1 text-[9px] font-mono tracking-[0.15em] text-silver-500"
                        >
                          SOSPECHOSO #{index + 1}
                        </div>

                        <div
                          class="font-mono text-sm font-bold text-bone-100"
                        >
                          {suspect.identification ||
                            'SIN IDENTIFICACIÓN'}
                        </div>

                      </div>


                      <div>

                        <div
                          class="mb-1 text-[9px] font-mono tracking-[0.15em] text-silver-500"
                        >
                          OBJETOS INCAUTADOS
                        </div>

                        <div
                          class="whitespace-pre-wrap text-sm text-silver-300"
                        >
                          {suspect.confiscated_items ||
                            'NINGUNO REGISTRADO'}
                        </div>

                      </div>

                    </div>

                  </div>
                ))
              }

            </div>
          ) : (
            <div
              class="text-xs font-mono text-silver-500"
            >
              SIN SOSPECHOSOS REGISTRADOS.
            </div>
          )
        }

      </div>

    </section>


    <!-- ================================================= -->
    <!-- VEHÍCULOS + EQUIPAMIENTO -->
    <!-- ================================================= -->

    <div
      class="grid gap-6 lg:grid-cols-2"
    >

      <!-- VEHÍCULOS -->

      <section
        class="border border-base-600 bg-base-900"
      >

        <div
          class="border-b border-base-600 px-5 py-4"
        >

          <div
            class="text-[10px] font-mono font-bold tracking-[0.2em] text-gold-500"
          >
            04 // VEHÍCULOS UTILIZADOS
          </div>

        </div>


        <div class="p-5">

          {
            vehicles && vehicles.length > 0 ? (
              <div class="space-y-2">

                {
                  vehicles.map((vehicle: any) => (
                    <div
                      class="border border-base-600 bg-base-950 px-4 py-3 text-sm text-silver-300"
                    >
                      {vehicle.description}
                    </div>
                  ))
                }

              </div>
            ) : (
              <div
                class="text-xs font-mono text-silver-500"
              >
                SIN VEHÍCULOS REGISTRADOS.
              </div>
            )
          }

        </div>

      </section>


      <!-- EQUIPAMIENTO -->

      <section
        class="border border-base-600 bg-base-900"
      >

        <div
          class="border-b border-base-600 px-5 py-4"
        >

          <div
            class="text-[10px] font-mono font-bold tracking-[0.2em] text-gold-500"
          >
            05 // MATERIAL UTILIZADO
          </div>

        </div>


        <div class="p-5">

          {
            equipment && equipment.length > 0 ? (
              <div class="space-y-2">

                {
                  equipment.map((item: any) => (
                    <div
                      class="border border-base-600 bg-base-950 px-4 py-3 text-sm text-silver-300"
                    >
                      {item.description}
                    </div>
                  ))
                }

              </div>
            ) : (
              <div
                class="text-xs font-mono text-silver-500"
              >
                SIN MATERIAL REGISTRADO.
              </div>
            )
          }

        </div>

      </section>

    </div>


    <!-- ================================================= -->
    <!-- GRABACIONES -->
    <!-- ================================================= -->

    <section
      class="border border-base-600 bg-base-900"
    >

      <div
        class="border-b border-base-600 px-5 py-4"
      >

        <div
          class="text-[10px] font-mono font-bold tracking-[0.2em] text-gold-500"
        >
          06 // GRABACIONES
        </div>

      </div>


      <div class="p-5">

        {
          recordings && recordings.length > 0 ? (
            <div class="space-y-2">

              {
                recordings.map((recording: any) => (
                  <a
                    href={recording.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block border border-base-600 bg-base-950 px-4 py-3 font-mono text-xs text-gold-400 transition hover:border-gold-500 hover:bg-gold-500/5"
                  >
                    {recording.url}
                  </a>
                ))
              }

            </div>
          ) : (
            <div
              class="text-xs font-mono text-silver-500"
            >
              SIN GRABACIONES REGISTRADAS.
            </div>
          )
        }

      </div>

    </section>

  </div>


  <!-- ================================================= -->
  <!-- REVIEW SCRIPT -->
  <!-- ================================================= -->

  {
    !isReviewed && isLeader && (
      <script>
        const reviewButton =
          document.querySelector<HTMLButtonElement>(
            '#review-button'
          );

        reviewButton?.addEventListener(
          'click',
          async () => {

            if (!reviewButton) return;

            const confirmed =
              window.confirm(
                '¿Confirmás que revisaste este informe?'
              );

            if (!confirmed) return;


            reviewButton.disabled = true;

            reviewButton.innerHTML =
              '<span>...</span><span>REVISANDO INFORME</span>';


            try {

              const response =
                await fetch(
                  '/api/despliegues/revisar',
                  {
                    method: 'POST',

                    headers: {
                      'Content-Type':
                        'application/json',
                    },

                    body: JSON.stringify({
                      deploymentId:
                        Number('{currentDeployment.id}')
                    }),
                  }
                );


              const text =
                await response.text();


              let result: any = null;

              try {
                result = JSON.parse(text);
              } catch {
                throw new Error(
                  'Respuesta inválida del servidor.'
                );
              }


              if (!response.ok || !result.success) {
                throw new Error(
                  result.error ||
                  'No se pudo revisar el informe.'
                );
              }


              window.location.reload();

            } catch (error) {

              console.error(
                'REVIEW ERROR:',
                error
              );

              alert(
                error instanceof Error
                  ? error.message
                  : 'No se pudo revisar el informe.'
              );


              reviewButton.disabled = false;

              reviewButton.innerHTML =
                '<span>✓</span><span>MARCAR COMO REVISADO</span>';

            }

          }
        );
      </script>
    )
  }

</OperatorLayout>