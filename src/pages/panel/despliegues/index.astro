---
import CommandLayout from '../../../layouts/CommandLayout.astro';
import {
  getCurrentMember,
  hasPermission,
} from '../../../lib/auth';
import { createApiClient } from '../../../lib/supabase-api';

const { member, permissions } =
  await getCurrentMember(Astro);

if (!member) {
  return Astro.redirect('/login');
}

if (!hasPermission(permissions, 'admin.access')) {
  return Astro.redirect('/panel');
}

const supabase = createApiClient(
  Astro.request,
  Astro.cookies
);

const { data: deployments, error } =
  await supabase
    .from('deployments')
    .select(`
      id,
      code,
      title,
      type,
      location,
      risk_level,
      status,
      report_status,
      created_at,
      reviewed_at,
      creator:members!deployments_created_by_fkey (
        id,
        full_name,
        callsign
      )
    `)
    .order('created_at', {
      ascending: false,
    });

if (error) {
  console.error(
    'ERROR OBTENIENDO DESPLIEGUES:',
    error
  );
}

const allDeployments = deployments ?? [];

const pendingCount =
  allDeployments.filter(
    (deployment) =>
      deployment.report_status ===
      'pending_review'
  ).length;

const reviewedCount =
  allDeployments.filter(
    (deployment) =>
      deployment.report_status ===
      'reviewed'
  ).length;

const criticalCount =
  allDeployments.filter(
    (deployment) =>
      deployment.risk_level === 'Crítico'
  ).length;

function formatDate(
  value: string | null | undefined
) {
  if (!value) {
    return '—';
  }

  return new Intl.DateTimeFormat(
    'es-PY',
    {
      dateStyle: 'short',
      timeStyle: 'short',
    }
  ).format(new Date(value));
}

function riskClass(
  risk: string | null | undefined
) {
  switch (risk) {
    case 'Crítico':
      return 'border-red-500/30 bg-red-500/10 text-red-300';

    case 'Alto':
      return 'border-orange-500/30 bg-orange-500/10 text-orange-300';

    case 'Medio':
      return 'border-yellow-500/30 bg-yellow-500/10 text-yellow-300';

    case 'Bajo':
      return 'border-green-500/30 bg-green-500/10 text-green-300';

    default:
      return 'border-base-600 bg-base-800 text-silver-300';
  }
}
---

<CommandLayout
  title="Despliegues | Centro de Mando"
>
  <div class="mx-auto max-w-7xl space-y-6">

    <!-- HEADER -->

    <section
      class="border border-base-600/70 bg-base-900"
    >
      <div
        class="flex flex-col gap-5 border-b border-base-600/60 px-6 py-6 lg:flex-row lg:items-end lg:justify-between lg:px-8"
      >
        <div>
          <p
            class="font-mono text-[10px] font-bold uppercase tracking-[0.3em] text-gold-500"
          >
            SRT / Gestión operacional
          </p>

          <h1
            class="mt-2 font-display text-2xl font-black uppercase tracking-wide text-bone-100 lg:text-3xl"
          >
            Despliegues
          </h1>

          <p
            class="mt-2 max-w-2xl font-mono text-xs leading-6 text-silver-400"
          >
            Registro centralizado de operaciones e informes
            realizados por el Special Response Team.
          </p>
        </div>

        <div
          class="flex items-center gap-3"
        >
          <div
            class="border border-base-600 bg-base-800 px-4 py-3"
          >
            <p
              class="font-mono text-[9px] uppercase tracking-wider text-silver-500"
            >
              Total
            </p>

            <p
              class="mt-1 font-mono text-xl font-bold text-bone-100"
            >
              {allDeployments.length}
            </p>
          </div>

          <div
            class="border border-yellow-500/20 bg-yellow-500/5 px-4 py-3"
          >
            <p
              class="font-mono text-[9px] uppercase tracking-wider text-yellow-500"
            >
              Pendientes
            </p>

            <p
              class="mt-1 font-mono text-xl font-bold text-yellow-300"
            >
              {pendingCount}
            </p>
          </div>

          <div
            class="hidden border border-green-500/20 bg-green-500/5 px-4 py-3 sm:block"
          >
            <p
              class="font-mono text-[9px] uppercase tracking-wider text-green-500"
            >
              Revisados
            </p>

            <p
              class="mt-1 font-mono text-xl font-bold text-green-300"
            >
              {reviewedCount}
            </p>
          </div>
        </div>
      </div>


      <!-- FILTROS -->

<div
class="grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-[1fr_180px_180px_auto]"
>

<div class="relative">

  <label
    for="deployment-search"
    class="sr-only"
  >
    Buscar despliegue
  </label>

  <input
    id="deployment-search"
    type="search"
    placeholder="Buscar código, título o ubicación..."
    class="h-11 w-full cursor-text border border-base-600 bg-base-800 px-4 font-mono text-xs text-bone-100 outline-none placeholder:text-silver-600 focus:border-gold-500/50"
  />

</div>


<div>

  <label
    for="review-filter"
    class="sr-only"
  >
    Estado de revisión
  </label>

  <select
    id="review-filter"
    class="h-11 w-full cursor-pointer border border-base-600 bg-base-800 px-3 font-mono text-xs uppercase text-silver-300 outline-none focus:border-gold-500/50"
  >

    <option value="all">
      Todas las revisiones
    </option>

    <option value="pending_review">
      Pendientes
    </option>

    <option value="reviewed">
      Revisados
    </option>

  </select>

</div>


<div>

  <label
    for="risk-filter"
    class="sr-only"
  >
    Nivel de riesgo
  </label>

  <select
    id="risk-filter"
    class="h-11 w-full cursor-pointer border border-base-600 bg-base-800 px-3 font-mono text-xs uppercase text-silver-300 outline-none focus:border-gold-500/50"
  >

    <option value="all">
      Todos los riesgos
    </option>

    <option value="Crítico">
      Crítico
    </option>

    <option value="Alto">
      Alto
    </option>

    <option value="Medio">
      Medio
    </option>

    <option value="Bajo">
      Bajo
    </option>

  </select>

</div>


<button
  id="clear-filters"
  type="button"
  class="h-11 cursor-pointer border border-base-600 bg-base-800 px-5 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-silver-300 transition hover:border-gold-500/40 hover:text-gold-500"
>
  Limpiar
</button>

</div>
    </section>


    <!-- LISTADO -->

    <section
      class="border border-base-600/70 bg-base-900"
    >

      <div
        class="flex items-center justify-between border-b border-base-600/60 px-6 py-4"
      >
        <div>
          <p
            class="font-mono text-[10px] font-bold uppercase tracking-[0.25em] text-gold-500"
          >
            Registro de operaciones
          </p>

          <p
            id="results-count"
            class="mt-1 font-mono text-[10px] uppercase text-silver-500"
          >
            {allDeployments.length} registros
          </p>
        </div>

        <div
          class="hidden items-center gap-2 sm:flex"
        >
          <span
            class="h-2 w-2 bg-yellow-400"
          ></span>

          <span
            class="font-mono text-[9px] uppercase tracking-wider text-silver-500"
          >
            Pendiente
          </span>

          <span
            class="ml-3 h-2 w-2 bg-green-400"
          ></span>

          <span
            class="font-mono text-[9px] uppercase tracking-wider text-silver-500"
          >
            Revisado
          </span>
        </div>
      </div>


      <div
        id="deployments-list"
        class="divide-y divide-base-600/50"
      >

        {
          allDeployments.length > 0 ? (
            allDeployments.map((deployment) => (
              <article
                class="deployment-row group px-6 py-5 transition hover:bg-base-800/60 lg:px-8"
                data-code={deployment.code ?? ''}
                data-title={deployment.title ?? ''}
                data-location={deployment.location ?? ''}
                data-risk={deployment.risk_level ?? ''}
                data-review={deployment.report_status ?? ''}
              >

                <div
                  class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between"
                >

                  <!-- INFO PRINCIPAL -->

                  <div class="min-w-0 flex-1">

                    <div
                      class="flex flex-wrap items-center gap-2"
                    >

                      <span
                        class="font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-gold-500"
                      >
                        {deployment.code}
                      </span>

                      <span class="text-base-600">
                        /
                      </span>

                      <span
                        class={`border px-2 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider ${riskClass(deployment.risk_level)}`}
                      >
                        {deployment.risk_level}
                      </span>

                      {
                        deployment.report_status ===
                        'pending_review' ? (
                          <span class="border border-yellow-500/20 bg-yellow-500/5 px-2 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider text-yellow-300">
                            Pendiente
                          </span>
                        ) : (
                          <span class="border border-green-500/20 bg-green-500/5 px-2 py-0.5 font-mono text-[9px] font-bold uppercase tracking-wider text-green-300">
                            Revisado
                          </span>
                        )
                      }

                    </div>


                    <h2
                      class="mt-2 truncate font-display text-base font-bold uppercase text-bone-100"
                    >
                      {deployment.title}
                    </h2>


                    <div
                      class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[10px] uppercase tracking-wider text-silver-500"
                    >
                      <span>
                        {deployment.type}
                      </span>

                      <span class="text-base-600">
                        /
                      </span>

                      <span>
                        {deployment.location}
                      </span>

                      <span class="text-base-600">
                        /
                      </span>

                      <span>
                        {formatDate(
                          deployment.created_at
                        )}
                      </span>
                    </div>

                  </div>


                  <!-- ALPHA -->

                  <div
                    class="shrink-0 border-l border-base-600/60 pl-4 lg:w-48"
                  >
                    <p
                      class="font-mono text-[9px] uppercase tracking-[0.15em] text-silver-500"
                    >
                      Alpha
                    </p>

                    <p
                      class="mt-1 truncate font-mono text-xs text-bone-100"
                    >
                      [
                      {deployment.creator?.callsign ??
                        '—'}
                      ]
                      {deployment.creator?.full_name ??
                        'Sin nombre'}
                    </p>
                  </div>


                  <!-- ACTION -->

                  <div class="shrink-0">
                    <a
                      href={`/despliegues/${deployment.id}`}
                      class="inline-flex min-h-11 items-center justify-center border border-base-600 bg-base-800 px-5 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-silver-300 transition hover:border-gold-500/50 hover:bg-gold-500/5 hover:text-gold-500"
                    >
                      Ver informe
                    </a>
                  </div>

                </div>

              </article>
            ))
          ) : (
            <div
              class="px-6 py-16 text-center"
            >
              <p
                class="font-mono text-xs uppercase tracking-wider text-silver-500"
              >
                No hay despliegues registrados.
              </p>
            </div>
          )
        }

        <div
          id="empty-filter-result"
          class="hidden px-6 py-16 text-center"
        >
          <p
            class="font-mono text-xs uppercase tracking-wider text-silver-500"
          >
            No se encontraron despliegues con los filtros actuales.
          </p>
        </div>

      </div>
    </section>

  </div>
</CommandLayout>


<script>
  const searchInput =
    document.querySelector(
      '#deployment-search'
    );

  const reviewFilter =
    document.querySelector(
      '#review-filter'
    );

  const riskFilter =
    document.querySelector(
      '#risk-filter'
    );

  const clearButton =
    document.querySelector(
      '#clear-filters'
    );

  const rows =
    Array.from(
      document.querySelectorAll(
        '.deployment-row'
      )
    );

  const emptyResult =
    document.querySelector(
      '#empty-filter-result'
    );

  const resultsCount =
    document.querySelector(
      '#results-count'
    );

  function filterDeployments() {
    const search =
      searchInput?.value
        .trim()
        .toLowerCase() ?? '';

    const review =
      reviewFilter?.value ?? 'all';

    const risk =
      riskFilter?.value ?? 'all';

    let visible = 0;

    rows.forEach((row) => {
      const code =
        row
          .getAttribute('data-code')
          ?.toLowerCase() ?? '';

      const title =
        row
          .getAttribute('data-title')
          ?.toLowerCase() ?? '';

      const location =
        row
          .getAttribute('data-location')
          ?.toLowerCase() ?? '';

      const rowRisk =
        row.getAttribute('data-risk') ?? '';

      const rowReview =
        row.getAttribute('data-review') ?? '';

      const matchesSearch =
        !search ||
        code.includes(search) ||
        title.includes(search) ||
        location.includes(search);

      const matchesReview =
        review === 'all' ||
        rowReview === review;

      const matchesRisk =
        risk === 'all' ||
        rowRisk === risk;

      const visibleRow =
        matchesSearch &&
        matchesReview &&
        matchesRisk;

      row.classList.toggle(
        'hidden',
        !visibleRow
      );

      if (visibleRow) {
        visible++;
      }
    });

    if (emptyResult) {
      emptyResult.classList.toggle(
        'hidden',
        visible !== 0
      );
    }

    if (resultsCount) {
      resultsCount.textContent =
        `${visible} ${
          visible === 1
            ? 'registro'
            : 'registros'
        }`;
    }
  }

  searchInput?.addEventListener(
    'input',
    filterDeployments
  );

  reviewFilter?.addEventListener(
    'change',
    filterDeployments
  );

  riskFilter?.addEventListener(
    'change',
    filterDeployments
  );

  clearButton?.addEventListener(
    'click',
    () => {
      if (searchInput) {
        searchInput.value = '';
      }

      if (reviewFilter) {
        reviewFilter.value = 'all';
      }

      if (riskFilter) {
        riskFilter.value = 'all';
      }

      filterDeployments();
    }
  );

  filterDeployments();
</script>