---
import '../styles/global.css';

interface Props {
  title?: string;
}

const {
  title = 'SRT | Special Response Team'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-950 text-bone-100 antialiased">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    overflow-x: hidden;
  }
</style>