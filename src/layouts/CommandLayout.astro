---
import '../styles/global.css';

import CommandHeader from '../components/command/CommandHeader.astro';
import CommandSidebar from '../components/command/CommandSidebar.astro';

interface Props {
  title?: string;
}

const {
  title = 'Centro de Mando | SRT'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0"
    />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
  </head>

  <body class="min-h-screen bg-base-950 text-bone-100 antialiased">

    <div class="relative min-h-screen overflow-hidden bg-base-950">

      <!-- =====================================================
           LOGO DE FONDO
           ===================================================== -->

      <img
        src="/img/srt-patch.png"
        alt=""
        aria-hidden="true"
        class="pointer-events-none fixed left-1/2 top-1/2 z-0 w-[650px] -translate-x-1/2 -translate-y-1/2 select-none opacity-[0.05]"
      />

      <!-- =====================================================
           CONTENIDO DE LA APLICACIÓN
           ===================================================== -->

      <div class="relative z-10">

        <!-- HEADER -->
        <CommandHeader />

        <!-- ESTRUCTURA -->
        <div class="flex">

          <!-- SIDEBAR -->
          <CommandSidebar />

          <!-- CONTENIDO -->
          <main class="min-w-0 flex-1 pt-20 lg:ml-64">

            <div class="min-h-[calc(100vh-5rem)] p-6 lg:p-8">
              <slot />
            </div>

          </main>

        </div>

      </div>

    </div>

  </body>

</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    overflow-x: hidden;
  }
</style>