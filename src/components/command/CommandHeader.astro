---
import { getCurrentMember } from '../../lib/auth';
import { createApiClient } from '../../lib/supabase-api';

const { member } = await getCurrentMember(Astro);

const memberName = member?.full_name ?? 'Operador';
const memberCallsign = member?.callsign ?? 'SIN PLACA';
const memberRank = member?.rank?.name ?? 'Sin rango';

let memberPhoto = '/img/default-operator.jpg';

if (member?.photo_url) {
  if (/^https?:\/\//.test(member.photo_url)) {
    memberPhoto = member.photo_url;
  } else {
    const supabase = createApiClient(Astro.request, Astro.cookies);

    const { data: signedPhoto } = await supabase.storage
      .from('avatars')
      .createSignedUrl(member.photo_url, 3600);

    memberPhoto = signedPhoto?.signedUrl ?? '/img/default-operator.jpg';
  }
}
---

<header class="fixed inset-x-0 top-0 z-50 h-20 border-b border-[#393a31] bg-[#13140f] shadow-[0_8px_24px_rgba(0,0,0,0.22)]">
  <!-- Acento de clasificación -->
  <div
    class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-[#454333] via-[#c0aa73] to-[#454333]"
    aria-hidden="true"
  ></div>

  <div class="relative flex h-full items-center justify-between gap-3 px-3 pt-[3px] sm:px-5 lg:px-7">
    <!-- OPERADOR -->
    <div class="flex min-w-0 items-center gap-3">
      <div class="brackets h-11 w-11 shrink-0 sm:h-12 sm:w-12" style="--b: 7px">
        <div class="h-full w-full overflow-hidden border border-[#514d3b] bg-[#202119]">
          <img
            src={memberPhoto}
            alt={`Fotografía de ${memberName}`}
            class="h-full w-full object-cover grayscale-[.15] contrast-110"
            onerror="this.onerror=null;this.src='/img/default-operator.jpg'"
          />
        </div>
      </div>

      <div class="min-w-0">
        <p class="max-w-[55vw] truncate font-display text-[12px] font-semibold uppercase tracking-[0.1em] text-bone-100 sm:max-w-none sm:text-sm">
          {memberName}
        </p>

        <p class="mt-1 flex min-w-0 items-center gap-1.5 font-mono text-[9px] uppercase tracking-[0.12em] sm:gap-2 sm:text-[10px]">
          <span class="truncate text-[#c9b47b]">{memberRank}</span>
          <span class="shrink-0 text-[#625f4d]" aria-hidden="true">/</span>
          <span class="truncate text-[#aaa899]">[{memberCallsign}]</span>
        </p>
      </div>
    </div>

    <!-- IDENTIDAD DEL PANEL -->
    <div class="absolute left-1/2 hidden -translate-x-1/2 text-center lg:block">
      <p class="font-mono text-[9px] uppercase tracking-[0.38em] text-[#9b9989]">
        Special Response Team
      </p>

      <h1 class="mt-1 font-display text-lg font-bold uppercase tracking-[0.2em] text-bone-100 xl:text-xl">
        Centro de Mando
      </h1>

      <div class="mx-auto mt-1.5 h-px w-12 bg-[#8b7b51]" aria-hidden="true"></div>
    </div>

    <!-- HORA LOCAL -->
    <div class="hidden border-l border-[#514d3b] pl-4 text-right md:block">
      <p class="font-mono text-[9px] uppercase tracking-[0.22em] text-[#9b9989]">
        Hora local
      </p>

      <time
        id="hdr-clock"
        class="font-mono text-sm tabular-nums tracking-wider text-[#c9b47b]"
      >
        --:--:--
      </time>
    </div>
  </div>
</header>

<script>
  const clock = document.querySelector<HTMLElement>('#hdr-clock');

  if (clock) {
    const fmt = new Intl.DateTimeFormat('es-PY', {
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });

    const tick = () => {
      clock.textContent = fmt.format(new Date());
    };

    tick();
    setInterval(tick, 1000);
  }
</script>